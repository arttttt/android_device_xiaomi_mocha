<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local manifest for the LineageOS 16.0 tree. Starting point for the port:
  the device tree is already on its own branch, everything else still points
  at its 15.1 branch and moves over as the work reaches it.

  Branch each fork only when it actually needs to diverge. A repo that builds
  unchanged against this branch has no reason to carry a second one, and an empty
  lineage-16.0 branch is worse than none, because it hides which parts have
  really been ported.

  Note for anyone editing this file: XML forbids a double hyphen inside a
  comment, and repo reports it only as "not well-formed (invalid token)"
  with a line and column, never as the reason.
-->
<manifest>
  <!-- Already branched -->
  <project name="arttttt/android_device_xiaomi_mocha" path="device/xiaomi/mocha" remote="github" revision="lineage-16.0" />

  <!-- Shared with 15.1: one kernel serves both, and the read() semantics and
       BT tx-queue fixes it carries are not version specific. -->
  <project name="arttttt/SmokeR24.1-kernel" path="kernel/xiaomi/mocha" remote="github" revision="SmokeR24.1-stable" />

  <!-- The blobs have their own 16.0 branch and this release needs it: the
       composer is built from source here, and the 15.1 branch still ships a
       prebuilt hwcomposer.tegra beside it. Two definitions of one module is a
       parse error rather than a preference, so the whole build stops at

         vendor/nvidia/shield/hal: MODULE.TARGET.SHARED_LIBRARIES.hwcomposer.tegra
         already defined by hardware/nvidia/hwcomposer

       and no full zip could be produced at all while this said 15.1. -->
  <project name="arttttt/proprietary_vendor_nvidia" path="vendor/nvidia" remote="github" revision="lineage-16.0" />

  <!-- Still on its 15.1 branch. The camera HAL will need at least a look at the
       Vulkan loader, since the platform may now expose the gralloc interop the
       HAL module path currently provides. -->
  <project name="arttttt/android-camera-hal" path="hardware/camera" remote="github" revision="lineage-15.1" />

  <!-- Branched for P. Upstream rebuilt its 16.0 line rather than continuing
       15.1, so our three fixes were replayed onto it rather than merged: the
       clang build fix turned out to be upstream already, the const array had
       been fixed there independently, and only the /vendor/etc conf path is
       genuinely ours. Note that upstream now installs brcm-uim-sysfs and
       libfmradio.v4l2-fm as proprietary modules, so both live in /vendor,
       and init.comms.rc starts the daemon from /vendor/bin accordingly. -->
  <project name="arttttt/android_hardware_broadcom_fm" path="hardware/broadcom/fm" remote="github" revision="lineage-16.0" />

  <!-- Our FM volume bridge, replayed onto upstream's 16.0. The BCM libfmjni
       guard we used to carry is upstream there already (5a56adc), so only the
       two volume commits remain ours. -->
  <remove-project name="LineageOS/android_packages_apps_FMRadio" />
  <project name="arttttt/android_packages_apps_FMRadio" path="packages/apps/FMRadio" remote="github" revision="lineage-16.0" />

  <!-- Our hardware composer. Ours alone and needed by this branch only, so it
       carries no per-release branches.

       Pinned to the working branch rather than to main, because that is where
       the composer actually is: the merge onto the controller's spare window,
       surviving a SurfaceFlinger restart, the fence switch and its counters.
       Saying main here did not build an older composer, it built one without
       any of that, quietly, on every sync. Once the branch lands on main this
       goes back to main. -->
  <project name="arttttt/android_hardware_nvidia_hwcomposer" path="hardware/nvidia/hwcomposer" remote="github" revision="feature/upstream-core" />

  <!-- NVIDIA support repos. Both have real lineage-16.0 branches upstream,
       so take those rather than the 15.1 ones. libstagefrighthw is the OMX
       plugin without which every hardware codec fails to allocate; thermal
       backs thermal.tegra, which device.mk asks for. -->
  <project name="LineageOS/android_hardware_nvidia_libstagefrighthw" path="hardware/nvidia/libstagefrighthw" remote="github" revision="lineage-16.0" />
  <project name="LineageOS/android_hardware_nvidia_thermal" path="hardware/nvidia/thermal" remote="github" revision="lineage-16.0" />
</manifest>
