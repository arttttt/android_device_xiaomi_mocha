<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local manifest for the LineageOS 17.1 tree. tools/build_lineage.sh installs it
  as .repo/local_manifests/mocha.xml.

  It starts with the three repositories a mocha tree cannot exist without: the
  kernel, the device tree and the blobs. Everything else that 16.0 carried, the
  composer, the camera HAL and the FM pair, joins as the bring-up reaches it,
  and each one is added only once it is known which branch it should point at.
  An entry aimed at the wrong branch is worse than a missing one, because a
  missing repository announces itself while a wrong revision quietly builds
  something nobody meant to build.

  Note for anyone editing this file: XML forbids a double hyphen inside a
  comment, and repo reports it only as "not well-formed (invalid token)"
  with a line and column, never as the reason.
-->
<manifest>
  <!-- One kernel serves every version. SmokeR24.1-stable is the line the 16.0
       release shipped from, and nothing in it is tied to a platform release. -->
  <project name="arttttt/SmokeR24.1-kernel" path="kernel/xiaomi/mocha" remote="github" revision="SmokeR24.1-stable" />

  <!-- Branched off the 16.0 head after the release, so it starts from exactly
       what shipped rather than from an older common ancestor. -->
  <project name="arttttt/android_device_xiaomi_mocha" path="device/xiaomi/mocha" remote="github" revision="lineage-17.1" />

  <!-- Branched off the 16.0 head as well, and it carries the commit that stops
       shield from building the composer this board no longer uses. That makes
       hardware/nvidia/hwcomposer below the only thing providing
       hwcomposer.tegra: the prebuilt beside it is exactly the second definition
       of one module that stopped every 16.0 build until the two were separated. -->
  <project name="arttttt/proprietary_vendor_nvidia" path="vendor/nvidia" remote="github" revision="lineage-17.1" />

  <!-- Our own composer, written for this board and needed by no other, so it
       carries no per-release branches at all: main is where it lives, and both
       16.0 and 17.1 read from it. It stays that way until the two releases need
       different code, and on the day they do the branch is made here, not by
       quietly pinning a revision. -->
  <project name="arttttt/android_hardware_nvidia_hwcomposer" path="hardware/nvidia/hwcomposer" remote="github" revision="main" />

  <!-- Branched for Q off the 15.1 head, the code 16.0 shipped with. Unlike the
       composer this HAL does carry per-release branches, because it is built
       against the platform: the HIDL camera provider and device versions are
       release specific, and the Vulkan loader picks its path by what the
       driver exposes on the running system. -->
  <project name="arttttt/android-camera-hal" path="hardware/camera" remote="github" revision="lineage-17.1" />

  <!-- The FM side of the Broadcom chip, branched for Q off the 16.0 head. It
       also carries brcm-uim-sysfs, which attaches the line discipline for
       Bluetooth as well as FM, so this repository is on the path of both
       radios even though nothing here is named after Bluetooth. Everything
       else Bluetooth needs is elsewhere: brcm_bt_drv in the kernel,
       bt_vendor.conf and vnd_mocha.txt in the device tree, libbt-vendor and
       the chip patch in the blobs, and the stack itself from upstream. -->
  <project name="arttttt/android_hardware_broadcom_fm" path="hardware/broadcom/fm" remote="github" revision="lineage-17.1" />

  <!-- FMRadio: the upstream entry lives in snippets/lineage.xml and has to be
       removed before ours can take the same path. Branched for Q off the 16.0
       head; what is genuinely ours here is the bridge that drives the FM DAC
       from the system volume keys. -->
  <remove-project name="LineageOS/android_packages_apps_FMRadio" />
  <project name="arttttt/android_packages_apps_FMRadio" path="packages/apps/FMRadio" remote="github" revision="lineage-17.1" />
</manifest>
