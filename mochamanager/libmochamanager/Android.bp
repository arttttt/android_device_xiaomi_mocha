// The tablet as sysfs and its properties describe it, without an interface
// on it. The mochamanager service links it statically and only translates
// its IDL into these calls, so a new interface is a new wrapper and not a
// new reader.
cc_library_static {
    name: "libmochamanager",
    proprietary: true,
    srcs: ["Board.cpp"],
    export_include_dirs: ["include"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    shared_libs: [
        "libbase",
        "liblog",
    ],
}
