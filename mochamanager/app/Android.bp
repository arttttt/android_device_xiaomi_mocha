// MiPad Manager: the tablet's information and its switches -- the
// presentation layer, a ViewModel and a View-based screen per tab, over the
// domain and data libraries.
//
// Platform-signed for the platform_app domain, which the sepolicy makes a
// client of the mochamanager service, and for ServiceManager, which is hidden
// API. Privileged for the serial number (READ_PRIVILEGED_PHONE_STATE) and
// the refresh rate settings, which are not public ones.
android_app {
    name: "MochaManager",
    system_ext_specific: true,
    privileged: true,
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    platform_apis: true,
    certificate: "platform",
    required: ["privapp-permissions-mochamanager"],
    static_libs: [
        "MochaManagerClient",
        "MochaManagerData",
        "MochaManagerDomain",
        "androidx.activity_activity-ktx",
        "androidx.appcompat_appcompat",
        "androidx.core_core-ktx",
        "androidx.fragment_fragment-ktx",
        "androidx.lifecycle_lifecycle-runtime-ktx",
        "androidx.lifecycle_lifecycle-viewmodel-ktx",
        "androidx.lifecycle_lifecycle-viewmodel-savedstate",
        "com.google.android.material_material",
        "kotlinx_coroutines",
        "kotlinx_coroutines_android",
    ],
    kotlincflags: [
        "-Xopt-in=kotlinx.coroutines.ExperimentalCoroutinesApi",
        "-Xopt-in=kotlinx.coroutines.FlowPreview",
    ],
}

prebuilt_etc {
    name: "privapp-permissions-mochamanager",
    system_ext_specific: true,
    sub_dir: "permissions",
    src: "privapp-permissions-mochamanager.xml",
    filename_from_src: true,
}
