<!-- A sensor: its name and live reading on one line, what it is below. A
     vector's axes are each their own plain text of a fixed width, coloured
     as the graphs draw them: spans in one text would have every frame
     measure it run by run. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sensor_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.MochaManager.Body" />

        <TextView android:id="@+id/axis_x" style="@style/Widget.MochaManager.Axis" />
        <TextView android:id="@+id/axis_y" style="@style/Widget.MochaManager.Axis" />
        <TextView android:id="@+id/axis_z" style="@style/Widget.MochaManager.Axis" />

        <TextView
            android:id="@+id/sensor_unit"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.MochaManager.Value" />
    </LinearLayout>

    <!-- An uncalibrated sensor's bias, or why there is no reading. -->
    <TextView
        android:id="@+id/sensor_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textAppearance="@style/TextAppearance.MochaManager.Sub"
        android:visibility="gone" />

    <TextView
        android:id="@+id/sensor_about"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.MochaManager.Sub"
        android:textSize="12sp" />
</LinearLayout>
