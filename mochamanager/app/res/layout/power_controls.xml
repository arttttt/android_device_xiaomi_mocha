<!-- The power mode and the performance profile: on the overview and on
     Power alike. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/power_mode"
        android:textAppearance="@style/TextAppearance.MochaManager.Value"
        android:textSize="17sp" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/modes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <Button android:id="@+id/mode_charge" style="@style/Widget.MochaManager.Segment"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/mode_charge" />
        <Button android:id="@+id/mode_hold" style="@style/Widget.MochaManager.Segment"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/mode_hold" />
        <Button android:id="@+id/mode_battery" style="@style/Widget.MochaManager.Segment"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/mode_battery" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        android:id="@+id/mode_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.MochaManager.Sub" />

    <!-- While the tablet runs on its battery with the cable in. -->
    <TextView
        android:id="@+id/mode_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_chip"
        android:backgroundTint="?attr/colorWarnContainer"
        android:padding="12dp"
        android:text="@string/mode_battery_warning"
        android:textAppearance="@style/TextAppearance.MochaManager.Body"
        android:textColor="?attr/colorWarn"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/profiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <Button android:id="@+id/profile_power_save" style="@style/Widget.MochaManager.Segment"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/profile_power_save" />
        <Button android:id="@+id/profile_efficiency" style="@style/Widget.MochaManager.Segment"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/profile_efficiency" />
        <Button android:id="@+id/profile_balanced" style="@style/Widget.MochaManager.Segment"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/profile_balanced" />
        <Button android:id="@+id/profile_performance" style="@style/Widget.MochaManager.Segment"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/profile_performance" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        android:id="@+id/profile_note"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/profile_saver_note"
        android:textAppearance="@style/TextAppearance.MochaManager.Sub" />
</LinearLayout>
