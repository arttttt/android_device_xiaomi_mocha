<resources>
    <!-- What the theme's own attributes do not name: the colours that carry
         a state -- good, warning, bad -- each with a soft container to sit
         on, and the track a bar runs in. -->
    <attr name="colorGood" format="color" />
    <attr name="colorGoodContainer" format="color" />
    <attr name="colorWarn" format="color" />
    <attr name="colorWarnContainer" format="color" />
    <attr name="colorBad" format="color" />
    <attr name="colorBadContainer" format="color" />
    <attr name="colorPrimaryContainer" format="color" />
    <attr name="colorSurfaceVariant" format="color" />
    <attr name="colorOnSurfaceVariant" format="color" />
    <attr name="colorOutline" format="color" />
    <attr name="colorTrack" format="color" />
    <!-- The three axes of a vector, in every graph and reading of one. -->
    <attr name="colorAxisX" format="color" />
    <attr name="colorAxisY" format="color" />
    <attr name="colorAxisZ" format="color" />
</resources>
