// MiPad Manager's domain: the models, what the screens need from the tablet
// as interfaces, and the logic that is no one's but the app's -- the
// accelerometer calibration, the advice whether to calibrate, the power
// history. Plain Kotlin with no Android in it, so it builds for the host and
// is tested there.
java_library {
    name: "MochaManagerDomain",
    host_supported: true,
    srcs: ["src/**/*.kt"],
    libs: [
        "kotlin-stdlib",
        "kotlinx_coroutines",
    ],
    kotlincflags: [
        "-Xopt-in=kotlinx.coroutines.ExperimentalCoroutinesApi",
        "-Xopt-in=kotlinx.coroutines.FlowPreview",
    ],
}

// atest MochaManagerDomainTests, or run the jar with org.junit.runner.JUnitCore.
java_test_host {
    name: "MochaManagerDomainTests",
    srcs: ["tests/**/*.kt"],
    static_libs: [
        "MochaManagerDomain",
        "junit",
        "kotlin-stdlib",
        "kotlinx_coroutines",
    ],
    test_options: {
        unit_test: true,
    },
}
