# Storage TWRP should offer that the system's fstab does not list as a mount:
# there the card and USB drives belong to vold, which recovery does not run.
# The card is named under both names its controller can have, as the
# alternate device of the entry: TWRP looks for it again on every mount, so a
# card inserted after boot is found under either one.
/external_sd    vfat    /dev/block/platform/sdhci-tegra.2/by-num/p1 /dev/block/platform/700b0400.sdhci/by-num/p1    flags=display="MICRO SD";storage;wipeingui;removable
/usb-otg        vfat    /dev/block/sda1 /dev/block/sda                 flags=display="USB OTG";storage;wipeingui;removable
