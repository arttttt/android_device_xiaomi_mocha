on init
	start watchdogd
	start hwservicemanager

	# The eMMC under both names it can have. This kernel names the controller
	# sdhci-tegra.3 (OF_DEV_AUXDATA in board-ardbeg.c); a kernel left to the
	# device tree alone names it after its address. The fstab says
	# sdhci-tegra.3, while releasetools of 19.1 and zips made for other ROMs
	# look under 700b0600.sdhci. The link whose name already exists fails
	# harmlessly, the other supplies the missing one -- but only if the real
	# directory is already there. Made before ueventd creates it, the two
	# links point at each other, ueventd can no longer create by-name inside,
	# and recovery sees no partitions. The wait is for that: with this kernel
	# it returns at once, under the other naming it times out after 5 s and
	# the second link covers it.
	# The card slot gets no links: the card may be inserted after boot, and a
	# link made before then breaks it the same way. twrp.flags names it under
	# both names instead.
	wait /dev/block/platform/sdhci-tegra.3
	symlink /dev/block/platform/sdhci-tegra.3 /dev/block/platform/700b0600.sdhci
	symlink /dev/block/platform/700b0600.sdhci /dev/block/platform/sdhci-tegra.3

	write /sys/block/mmcblk0/queue/read_ahead_kb 128
	write /sys/module/workqueue/parameters/power_efficient 1
	write /sys/devices/system/cpu/cpuquiet/tegra_cpuquiet/enable 0

	write /sys/block/mmcblk0/queue/scheduler "row"
	# The kernel boots on userspace and has no elementalx any more; interactive
	# is what 19.1 runs (init.t124.rc).
	write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor interactive
	write /sys/kernel/tegra_gpu/gpu_floor_state 1
	write /sys/kernel/tegra_gpu/gpu_floor_rate 72000000
	write /sys/kernel/tegra_gpu/gpu_cap_state 1
	write /sys/kernel/tegra_gpu/gpu_cap_rate 540000000
	write /sys/module/input_cfboost/parameters/boost_enabled 0
	write /sys/devices/system/cpu/cpu1/online 1
	write /sys/devices/system/cpu/cpu2/online 1
	write /sys/devices/system/cpu/cpu3/online 1

# The kernel arms the watchdog itself: tegra124-tn8.dtsi asks for
# nvidia,enable-on-init with a 120 second heartbeat, and the board builds with
# CONFIG_WATCHDOG_NOWAYOUT, so nothing can stop it once it runs and the board
# resets silently after two minutes unless something feeds it. Every 10 seconds
# with a 110 second margin sets the same 120 the device tree asks for, as on
# 19.1. On 12.1 the binary lives in /system/bin, not /sbin.
service watchdogd /system/bin/watchdogd 10 110
    class core
    seclabel u:r:watchdogd:s0

# Battery. Recovery reads the level through the health HAL, and libhidl in
# the recovery process waits for hwservicemanager.ready with no time limit
# once /dev/hwbinder exists, which it does here. TWRP has its own
# hwservicemanager.rc for this, but builds it only for A/B, dynamic
# partitions or TW_INCLUDE_CRYPTO, none of which this tree has, so without
# the service below the battery thread hangs and the level is never shown.
# The definition is TWRP's, word for word.
service hwservicemanager /system/bin/hwservicemanager
    user root
    group root
    onrestart setprop hwservicemanager.ready false
    disabled
    seclabel u:r:recovery:s0

# The HAL that serves the level. TWRP defines health-hal-2-1 in
# /system/etc/init but starts it nowhere. It registers with hwservicemanager,
# so it waits for it, as the recovery process does.
on property:hwservicemanager.ready=true
    start health-hal-2-1
