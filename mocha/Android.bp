cc_library_static {
    name: "mocha_init",
    recovery_available: true,
    srcs: ["mocha_init.cpp"],
    // android-base/logging.h. The headers moved from system/core/base to
    // system/libbase on S; the module that exports them did not move with
    // them, so name that instead of a path.
    header_libs: ["libbase_headers"],
}
