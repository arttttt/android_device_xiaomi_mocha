# Mocha debug: stream Android logcat to UART (/dev/ttyS0).
# Provides early-boot log capture when adb is not yet available
# (e.g. boot loop in init/zygote, mediaserver wedge, SELinux denials).
#
# Off unless asked for: the stream costs a logcat process writing every
# line of every log to the serial port on every boot, watched or not.
# The persist property lives in /data, so it survives a reboot AND a
# reflash -- armed before flashing, it captures the first boot of a new
# system, which is exactly the boot adb cannot show.

# Warnings and above only.
#
# The serial line carries about eleven kilobytes a second, and a boot's worth
# of logcat is several megabytes. Unfiltered, the stream does not merely
# arrive late: it crowds out the kernel's own messages on the same port and
# drops its own lines while falling behind, so the log ends up missing both
# halves. That cost real evidence during this bring-up -- conn_init's summary
# never appeared, and neither did the reason for a reboot.
#
# Everything worth waking up for is W or above: crashes, ANRs, services
# failing to start, HALs refusing to answer. What is lost is the running
# commentary, which the kernel log and init's own messages already cover.
service logcat-uart /system/bin/sh -c "exec /system/bin/logcat -b all -v threadtime '*:W' > /dev/ttyS0 2>&1"
    class main
    user root
    group root log
    disabled

on property:persist.vendor.uartlog=1
    start logcat-uart

on property:persist.vendor.uartlog=0
    stop logcat-uart
