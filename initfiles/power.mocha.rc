# power save
on property:sys.perf.profile=0
  write /sys/block/mmcblk0/queue/scheduler "noop"
  write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor "interactive"
  # Root-owned as the kernel makes them, and the HAL is not root -- the
  # balanced profile says what this is for.
  chown system system /sys/devices/system/cpu/cpufreq/interactive/boostpulse
  chmod 0220 /sys/devices/system/cpu/cpufreq/interactive/boostpulse
  chown system system /sys/devices/system/cpu/cpufreq/interactive/io_is_busy
  chmod 0664 /sys/devices/system/cpu/cpufreq/interactive/io_is_busy
  write /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq 1044000
  write /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq 204000
  write /sys/kernel/tegra_gpu/gpu_floor_state 1
  write /sys/kernel/tegra_gpu/gpu_floor_rate 72000000
  write /sys/kernel/tegra_gpu/gpu_cap_state 1
  write /sys/kernel/tegra_gpu/gpu_cap_rate 396000000
  # Off. The clock is raised by the pulse the power HAL sends instead --
  # see the note in the balanced profile. Values kept so that turning this
  # back on is one character.
  write /sys/module/input_cfboost/parameters/boost_enabled 0
  write /sys/module/input_cfboost/parameters/boost_freq 696000
  write /sys/module/input_cfboost/parameters/boost_time 75
  write /sys/module/input_cfboost/parameters/boost_emc 0
  write /sys/module/input_cfboost/parameters/boost_gpu 252000
  write /sys/devices/system/cpu/cpu1/online 1
  write /sys/devices/system/cpu/cpu2/online 0
  write /sys/devices/system/cpu/cpu3/online 0
  write /sys/devices/system/cpu/cpufreq/interactive/timer_rate 20000
  write /sys/devices/system/cpu/cpufreq/interactive/timer_slack 80000
  write /sys/devices/system/cpu/cpufreq/interactive/min_sample_time 40000
  write /sys/devices/system/cpu/cpufreq/interactive/above_hispeed_delay 20000
  write /sys/devices/system/cpu/cpufreq/interactive/go_hispeed_load 99
  write /sys/devices/system/cpu/cpufreq/interactive/hispeed_freq 696000
  write /sys/devices/system/cpu/cpufreq/interactive/target_loads "80 204000:85 564000:90"
  write /sys/devices/system/cpu/cpufreq/interactive/boostpulse_duration 250000

# bias power save
on property:sys.perf.profile=3
  write /sys/block/mmcblk0/queue/scheduler "row"
  write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor "interactive"
  # Root-owned as the kernel makes them, and the HAL is not root -- the
  # balanced profile says what this is for.
  chown system system /sys/devices/system/cpu/cpufreq/interactive/boostpulse
  chmod 0220 /sys/devices/system/cpu/cpufreq/interactive/boostpulse
  chown system system /sys/devices/system/cpu/cpufreq/interactive/io_is_busy
  chmod 0664 /sys/devices/system/cpu/cpufreq/interactive/io_is_busy
  write /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq 1530000
  write /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq 204000
  write /sys/kernel/tegra_gpu/gpu_floor_state 1
  write /sys/kernel/tegra_gpu/gpu_floor_rate 72000000
  write /sys/kernel/tegra_gpu/gpu_cap_state 1
  write /sys/kernel/tegra_gpu/gpu_cap_rate 540000000
  write /sys/module/input_cfboost/parameters/boost_enabled 0
  write /sys/devices/system/cpu/cpu1/online 1
  write /sys/devices/system/cpu/cpu2/online 1
  write /sys/devices/system/cpu/cpu3/online 0
  write /sys/devices/system/cpu/cpufreq/interactive/timer_rate 20000
  write /sys/devices/system/cpu/cpufreq/interactive/timer_slack 80000
  write /sys/devices/system/cpu/cpufreq/interactive/min_sample_time 60000
  write /sys/devices/system/cpu/cpufreq/interactive/above_hispeed_delay 20000
  write /sys/devices/system/cpu/cpufreq/interactive/go_hispeed_load 99
  write /sys/devices/system/cpu/cpufreq/interactive/hispeed_freq 828000
  write /sys/devices/system/cpu/cpufreq/interactive/target_loads "75 204000:80 564000:88"
  write /sys/devices/system/cpu/cpufreq/interactive/boostpulse_duration 400000

# balanced
on property:sys.perf.profile=1
  write /sys/block/mmcblk0/queue/scheduler "row"
  write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor "interactive"
  # This governor's control nodes belong to root, and the power HAL does not.
  # boostpulse is created 0200 root:root and io_is_busy 0644 root:root, while
  # android.hardware.power@1.0-service.mocha runs as system, so every open of
  # them returned EACCES -- and the HAL says so exactly once:
  #
  #   no .../interactive/boostpulse; touch and launch hints will not raise
  #   the clock
  #
  # after which the failure is silent. The pulse this whole profile is built
  # around had therefore never fired at all. A trace of an application opening
  # shows the governor climbing 312 -> 1734 MHz in eight sampling ticks with
  # nobody pushing it, which is what that looks like from the outside.
  #
  # Granted here rather than in ueventd because this directory does not exist
  # until a governor is chosen -- the kernel default is userspace -- so a rule
  # there would race the node into being. Repeated in every profile because
  # leaving interactive and coming back destroys the group and recreates it,
  # taking the ownership with it.
  chown system system /sys/devices/system/cpu/cpufreq/interactive/boostpulse
  chmod 0220 /sys/devices/system/cpu/cpufreq/interactive/boostpulse
  chown system system /sys/devices/system/cpu/cpufreq/interactive/io_is_busy
  chmod 0664 /sys/devices/system/cpu/cpufreq/interactive/io_is_busy
  write /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq 1836000
  write /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq 204000
  write /sys/kernel/tegra_gpu/gpu_floor_state 1
  write /sys/kernel/tegra_gpu/gpu_floor_rate 72000000
  write /sys/kernel/tegra_gpu/gpu_cap_state 1
  write /sys/kernel/tegra_gpu/gpu_cap_rate 708000000
  # One boost mechanism, not two.
  #
  # input_cfboost is a kernel module that watches raw input events and puts a
  # PM QoS floor under the governor. It is switched off in every profile, in
  # favour of the pulse the power HAL sends to this governor's own boostpulse
  # node, for three reasons:
  #
  #   It knows why. The framework sends INTERACTION and LAUNCH, so a touch and
  #   an application starting are told apart -- and a launch may involve no
  #   touch at all, which the kernel module can never see.
  #
  #   Its unique contribution is currently empty. The only thing it does that
  #   boostpulse cannot is raise memory and graphics; boost_emc is 0 in every
  #   profile that had it on, so memory was never raised, and the GPU was
  #   measured not to be the constraint -- three times its clock changed the
  #   frame not at all.
  #
  #   Two sources of frequency decisions are twice the work to reason about
  #   when the clock behaves oddly: whose floor was that.
  #
  # Turning it back on is one character per profile; the values are kept.
  write /sys/module/input_cfboost/parameters/boost_enabled 0
  write /sys/devices/system/cpu/cpu1/online 1
  write /sys/devices/system/cpu/cpu2/online 1
  write /sys/devices/system/cpu/cpu3/online 1
  # The only set below that has been measured; the other three profiles are
  # this shape scaled to their own ceilings and are not.
  #
  # Everything the frame needs is raised by the boost the power HAL pulses on
  # touch and on launch, not by the load path -- which is why go_hispeed_load
  # is left where it cannot be reached, exactly as the two Tegra devices that
  # shipped with this governor do.
  #
  # Measured on the same hand test: presents arriving one refresh apart went
  # from 52 % to 94 %, SystemUI's frame from 36.4 ms to 14.97 against a budget
  # of 16.66, and its frames longer than two refreshes from 48 % to none.
  #
  # The hold is 500 ms rather than the 1000 the Tegra devices use. A hundred
  # was measured and is too short -- the clock drops between frames of one
  # animation and the next frame starts late. Between 500 and 1000 a single
  # hand test cannot tell the difference, so the cheaper one is taken.
  write /sys/devices/system/cpu/cpufreq/interactive/timer_rate 20000
  write /sys/devices/system/cpu/cpufreq/interactive/timer_slack 20000
  write /sys/devices/system/cpu/cpufreq/interactive/min_sample_time 80000
  write /sys/devices/system/cpu/cpufreq/interactive/above_hispeed_delay 20000
  write /sys/devices/system/cpu/cpufreq/interactive/go_hispeed_load 99
  write /sys/devices/system/cpu/cpufreq/interactive/hispeed_freq 1122000
  write /sys/devices/system/cpu/cpufreq/interactive/target_loads "65 204000:75 564000:85"
  write /sys/devices/system/cpu/cpufreq/interactive/boostpulse_duration 500000

# high performance
on property:sys.perf.profile=2
  write /sys/block/mmcblk0/queue/scheduler "row"
  write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor "interactive"
  # Root-owned as the kernel makes them, and the HAL is not root -- the
  # balanced profile says what this is for.
  chown system system /sys/devices/system/cpu/cpufreq/interactive/boostpulse
  chmod 0220 /sys/devices/system/cpu/cpufreq/interactive/boostpulse
  chown system system /sys/devices/system/cpu/cpufreq/interactive/io_is_busy
  chmod 0664 /sys/devices/system/cpu/cpufreq/interactive/io_is_busy
  write /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq 2218000
  write /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq 204000
  write /sys/kernel/tegra_gpu/gpu_floor_state 1
  write /sys/kernel/tegra_gpu/gpu_floor_rate 72000000
  write /sys/kernel/tegra_gpu/gpu_cap_state 1
  write /sys/kernel/tegra_gpu/gpu_cap_rate 852000000
  # Off, as in every profile now -- see the balanced one for why.
  write /sys/module/input_cfboost/parameters/boost_enabled 0
  write /sys/module/input_cfboost/parameters/boost_freq 1044000
  write /sys/module/input_cfboost/parameters/boost_time 100
  write /sys/module/input_cfboost/parameters/boost_emc 0
  write /sys/module/input_cfboost/parameters/boost_gpu 252000
  write /sys/devices/system/cpu/cpu1/online 1
  write /sys/devices/system/cpu/cpu2/online 1
  write /sys/devices/system/cpu/cpu3/online 1
  write /sys/devices/system/cpu/cpufreq/interactive/timer_rate 20000
  write /sys/devices/system/cpu/cpufreq/interactive/timer_slack 20000
  write /sys/devices/system/cpu/cpufreq/interactive/min_sample_time 80000
  write /sys/devices/system/cpu/cpufreq/interactive/above_hispeed_delay 20000
  write /sys/devices/system/cpu/cpufreq/interactive/go_hispeed_load 99
  write /sys/devices/system/cpu/cpufreq/interactive/hispeed_freq 1428000
  write /sys/devices/system/cpu/cpufreq/interactive/target_loads "60 204000:70 564000:80"
  write /sys/devices/system/cpu/cpufreq/interactive/boostpulse_duration 1000000
  write /sys/devices/system/cpu/cpufreq/interactive/io_busy_threshold 100
  write /sys/devices/system/cpu/cpufreq/interactive/io_is_busy 1

#undervoltage

#switched on
on property:sys.perf.undervoltage=1
  write /sys/kernel/debug/clock/vdd_core_offs -80
  write /sys/kernel/debug/clock/vdd_gpu_offs -45

#switched off
on property:sys.perf.undervoltage=0
  write /sys/kernel/debug/clock/vdd_core_offs 0
  write /sys/kernel/debug/clock/vdd_gpu_offs 0

