# The USB gadget this board composes into.
#
# The kernel no longer has android.c, so there is no /sys/class/android_usb
# to write to: the gadget lives in configfs. What composes it is
# android.hardware.usb.gadget@1.0-service.mocha, which UsbDeviceManager calls
# when it changes functions. What is here is everything that has to exist
# before it can -- the gadget, its strings, its configuration and every
# function instance -- because nothing in system/core creates any of that,
# and the service is started too late to be first.
#
# The instance names are the platform's, so mtp is gs0, ptp is gs1, accessory
# is gs2 and audio_source is gs3: the HAL looks functions up by exactly these
# paths, and a name that does not match is a function that silently never
# appears. rndis.gs4 is
# deliberately absent from the list below: it claims a network interface
# while it exists, so it is created when asked for and removed again after,
# by whichever side is composing.
#
# The board is called tn8 here and elsewhere. It shares its kernel and its
# drivers with NVIDIA's SHIELD Tablet, which is where the name comes from,
# and it is kept on purpose.

on init
    # configfs is already mounted: the platform init.rc does it in its own
    # "on init", which runs before this one.
    mkdir /config/usb_gadget/g1 0770 shell shell
    mkdir /config/usb_gadget/g1/strings/0x409 0770 shell shell
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /config/usb_gadget/g1/functions/mtp.gs0
    mkdir /config/usb_gadget/g1/functions/ptp.gs1
    mkdir /config/usb_gadget/g1/functions/accessory.gs2
    mkdir /config/usb_gadget/g1/functions/audio_source.gs3
    mkdir /config/usb_gadget/g1/configs/b.1 0770 shell shell
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell

    # The product id here is only the one the gadget carries before anything
    # composes it. Per-combination ids are the gadget HAL's to write, since
    # it is the only thing that knows what is about to be linked; the
    # platform's init.usb.configfs.rc never writes one at all.
    write /config/usb_gadget/g1/idVendor 0x0955
    write /config/usb_gadget/g1/idProduct 0xCF09
    write /config/usb_gadget/g1/bcdDevice 0x0223
    write /config/usb_gadget/g1/bDeviceClass 0
    write /config/usb_gadget/g1/bDeviceSubClass 0
    write /config/usb_gadget/g1/bDeviceProtocol 0
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer ${ro.product.manufacturer}
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}
    write /config/usb_gadget/g1/configs/b.1/MaxPower 500

    # What binds the gadget gets written to UDC, and this is the name. udc-core
    # names the entry in /sys/class/udc after the parent device --
    # dev_set_name(&udc->dev, "%s", kobject_name(&parent->kobj)) -- and the
    # parent here is not called what the device tree node suggests. The
    # controller is described by udc@7d000000, but board-ardbeg.c carries
    #
    #     OF_DEV_AUXDATA("nvidia,tegra124-udc", TEGRA_USB_BASE,
    #                    "tegra-udc.0", &tegra_udc_pdata.u_data.dev)
    #
    # and auxdata exists precisely to give a device probed from the tree the
    # legacy name a driver expects. So the device is tegra-udc.0, which is
    # also what the kernel log calls it, and 7d000000.udc -- the name the
    # node alone would imply -- matches nothing: writing it to UDC fails
    # with ENODEV and the gadget is built and never bound.
    setprop sys.usb.controller tegra-udc.0

# sys.usb.configfs is deliberately NOT set here, so it keeps the 0 the
# platform's own init.usb.rc gives it. It is the switch that says "init
# composes the configfs gadget", and init must not: the gadget HAL does, and
# two composers is not a division of labour but a race.
#
# It was set to 1 while init was the only composer, and that was right then.
# With the HAL it is actively harmful. persist.sys.usb.config makes
# init.usb.rc raise sys.usb.config at boot, and init.usb.configfs.rc answers
#
#     on property:sys.usb.ffs.ready=1 && property:sys.usb.config=mtp,adb \
#                                    && property:sys.usb.configfs=1
#         symlink .../functions/mtp.gs0 .../configs/b.1/f1
#         symlink .../functions/ffs.adb .../configs/b.1/f2
#         write .../UDC ${sys.usb.controller}
#
# which arrives after the HAL has already composed and bound, because
# sys.usb.ffs.ready is set by adbd once it has written its descriptors. The
# second symlink of mtp is what kills the board. config_usb_cfg_link() only
# refuses a function that is still on the configuration's func_list, and by
# then the bind has moved every function off that list, so the check passes.
# f_mtp hands out one usb_function per instance -- function_alloc_mtp_ptp()
# returns &dev->function from its single mtp_dev -- so the link gets back the
# function that is already in the configuration and list_add_tail() splices
# the two lists. The next time the host asks for the configuration
# descriptor, config_buf() walks off the end and dereferences the
# configuration's own next_interface_id as a descriptor table:
#
#     Unable to handle kernel NULL pointer dereference at 00000702
#     PC is at usb_descriptor_fillbuf+0x1c
#
# With it left at 0 none of init.usb.configfs.rc's actions can match, and the
# legacy half of init.usb.rc answers instead -- its writes to
# /sys/class/android_usb fail harmlessly, since nothing there is writable any
# more, and the one thing it does that still matters, starting adbd, is
# wanted. The composition itself is the HAL's alone.

on fs
    # The mount attaches to the FunctionFS instance named adb, which is
    # the ffs.adb created above -- "on init" has already run by now.
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000

    # Nothing here selects adbd's FunctionFS implementation. The property
    # this file used to set, sys.usb.ffs.aio_compat, is not one adbd reads on
    # Q at all; the choice is ro.adb.nonblocking_ffs, and nothing sets it any
    # more -- the kernel's FunctionFS does AIO now, so adbd is left to pick
    # the asynchronous back end it prefers.
