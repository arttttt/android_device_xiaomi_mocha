on boot
    # UART device
    chmod 0660 /dev/ttyHS2
    chown bluetooth bluetooth /dev/ttyHS2
    chmod 0660 /dev/ttyTHS2
    chown bluetooth bluetooth /dev/ttyTHS2

    # power up/down interface
    chmod 0660 /sys/class/rfkill/rfkill0/state
    chmod 0660 /sys/class/rfkill/rfkill0/type
    chown bluetooth bluetooth /sys/class/rfkill/rfkill0/state
    chown bluetooth bluetooth /sys/class/rfkill/rfkill0/type

    # bluetooth MAC address programming
    chown bluetooth bluetooth ro.bt.bdaddr_path
    chown bluetooth bluetooth /system/etc/bluetooth

    # Wifi firmware reload path
    chown wifi wifi /sys/module/bcmdhd/parameters/firmware_path

on post-fs-data
    # The framework still keeps its own state here: WifiConfigStore.xml and the
    # softap config live in /data/misc/wifi on P as they did before.
    mkdir /data/misc/wifi 0771 wifi wifi
    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    mkdir /data/misc/wifi/firmware 0770 wifi system

    # The supplicant's own state moved under /data/vendor on P. Nothing creates
    # these for us: the platform init.rc leaves /data/vendor to the device.
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi

# The supplicant is a HIDL service on P, so it takes neither an interface nor a
# config file on the command line: the framework hands it interfaces over
# ISupplicant, and the config is seeded by the HIDL layer itself, which copies
# /vendor/etc/wifi/wpa_supplicant.conf to /data/vendor/wifi/wpa on the first
# addInterface and reads the overlays from /vendor/etc/wifi as well.
#
# The old N-era line asked for -c/data/misc/wifi/wpa_supplicant.conf, a file
# nothing on P ever writes. Wi-Fi therefore worked only on devices that still
# carried it over from an earlier install, and died on a clean flash with
# "Failed to open config file", taking ISupplicant down with it.
service wpa_supplicant /vendor/bin/hw/wpa_supplicant \
    -O/data/vendor/wifi/wpa/sockets -puse_p2p_group_interface=1 \
    -g@android:wpa_wlan0
    interface android.hardware.wifi.supplicant@1.0::ISupplicant default
    interface android.hardware.wifi.supplicant@1.1::ISupplicant default
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

service dns_masq /system/bin/dnsmasq --no-daemon --no-resolv --no-poll --dhcp-option-force=43,ANDROID_METERED --dhcp-range=192.168.42.2,192.168.42.254,1h &
    class main
    user dhcp
    group dhcp wifi system
    disabled
    oneshot

# brcm-uim-sysfs (BT/FM/ANT+) — polls /sys/devices/platform/bcm_ldisc/install
# and attaches N_BRCM_HCI ldisc on demand. Persistent daemon, idles in poll()
# until something opens /dev/radio0 or the BT char device.
service uim /vendor/bin/brcm-uim-sysfs
    class late_start
    user root
    group bluetooth net_bt
