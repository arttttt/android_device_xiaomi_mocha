import /vendor/etc/init/hw/init.comms.rc

on early-init
    mount debugfs debugfs /sys/kernel/debug mode=0755

on init
    # The zygote path whitelist shim used to be forced in here with
    #
    #     export LD_PRELOAD "libshim_zw.so"
    #
    # which every process on the system then inherited. That is survivable
    # while everything links against /system/lib, and fatal once anything
    # does not: an APEX binary gets its own linker namespace, which cannot
    # see /system/lib, so the preload it inherited cannot be resolved and
    # the executable refuses to link at all --
    #
    #     CANNOT LINK EXECUTABLE "/apex/com.android.media.swcodec/bin/
    #     mediaswcodec": library "libshim_zw.so" not found
    #
    # media.swcodec then crash-looped, which is an updatable process, which
    # made init set ro.init.updatable_crashing and flags_health_check reboot
    # the device as disaster recovery -- during setup, looking like the
    # system falling over for no reason. Everything in the runtime APEX was
    # equally exposed.
    #
    # The shim is wanted by exactly one process, so it is aimed at exactly
    # one process now: see TARGET_LD_SHIM_LIBS in BoardConfig.mk.

    mkdir /mnt/media_rw/sdcard1 0700 media_rw media_rw
    
    # Support legacy paths
    symlink /sdcard /mnt/sdcard
    symlink /sdcard /storage/sdcard0

    # create directory for mounting usb drives
    mkdir /mnt/media_rw/usbdrive 0700 media_rw media_rw
    mkdir /storage/usbdrive 0700 root root
    symlink /mnt/media_rw/usbdrive /storage/usbdrive
    symlink /mnt/media_rw/usbdrive /usbdrive

    start watchdogd

on fs
# mount console ramooops
   mount pstore pstore /sys/fs/pstore

on post-fs-data
    mkdir /data/misc/dhcp 0770 dhcp dhcp
    mkdir /data/misc/hwc 0771 system graphics
    chown dhcp dhcp /data/misc/dhcp

    # Set indication (checked by vold) that we have finished this action
    setprop vold.post_fs_data_done 1

    # create directory for mediaserver EGL blob cache
    mkdir /data/misc/mediaserver 0770 media media

# Set up HDCP
import /vendor/etc/init/hw/init.hdcp.rc

on boot

# backlight
    chown system system /sys/class/backlight/lcd-backlight/brightness
    
# charger
    chown system system /sys/devices/platform/7000c400.i2c/i2c-1/1-006b/disabled_by_user

# didim
    chown system system /sys/devices/platform/host1x/tegradc.0/smartdimmer/enable
    chown system system /sys/devices/platform/host1x/tegradc.0/smartdimmer/aggressiveness
    chown system system /sys/devices/platform/host1x/tegradc.0/smartdimmer/sd_window
    chown system system /sys/devices/platform/host1x/tegradc.0/smartdimmer/sd_window_enable

#dt2w
    chown system system /sys/devices/platform/7000c700.i2c/i2c-3/3-004a/wakeup_mode
    chown system system /sys/devices/platform/7000c700.i2c/i2c-3/3-0020/input/input0/wake_gesture
    chown system system /sys/devices/platform/7000c700.i2c/i2c-3/3-0020/input/input3/wake_gesture

## cmhw permissions
# key disabler
    chown system system /sys/devices/platform/7000c700.i2c/i2c-3/3-004a/enable_keys
    chown system system /sys/devices/platform/7000c700.i2c/i2c-3/3-0020/input/input0/0dbutton
    chown system system /sys/devices/platform/7000c700.i2c/i2c-3/3-0020/input/input3/0dbutton

# vibrator intensity, and the pattern the named effects are played as.
#
# Both are made root-owned by the driver and the service runs as system, the
# same trap the interactive governor's boostpulse and the GPU floor are in.
# Without the second of these the vibrator HAL cannot play an effect at all:
# perform() fails, the framework falls back to plain vibration at close to
# full strength, and the three intensities offered in the settings all feel
# alike because none of them is ever used.
#
# The platform grants the neighbouring "enable" the same way, from init.rc,
# rather than through ueventd.
    chown system system /sys/vibrator/pwmvalue
    chown system system /sys/class/timed_output/vibrator/pattern

# CMU
    chown system system /sys/devices/platform/host1x/tegradc.0/cmu_enable

# power
    chown system system /sys/kernel/tegra_cap/core_cap_level
    chown system system /sys/kernel/tegra_cap/core_cap_state
    chown system system /sys/kernel/tegra_volt_cap/cpu_volt
    chmod 0664 /sys/kernel/tegra_volt_cap/cpu_volt
    chown system system /sys/module/cpu_tegra/parameters/cpu_user_cap
    chown system system /sys/devices/platform/host1x/gk20a.0/enable_3d_scaling

# audio
    chmod 0664 /sys/power/suspend/mode
    chown system audio /sys/power/suspend/mode

# Tegra wakeup monitor
    chown system system /sys/devices/platform/tegra_wakeup_monitor/cmd
    chown system system /sys/devices/platform/tegra_wakeup_monitor/monitor_enable
    chown system system /sys/devices/platform/tegra_wakeup_monitor/nf_enable
    chown system system /sys/devices/platform/tegra_wakeup_monitor/am_enable
    chown system system /sys/devices/platform/tegra_wakeup_monitor/init_ports
    chown system system /sys/devices/platform/tegra_wakeup_monitor/add_ports
    chown system system /sys/devices/platform/tegra_wakeup_monitor/del_ports

# Sensor
    chown system system /sys/class/sensors/light/device/amb_clear

# Touch
    chown system system /sys/class/input/input0/enabled

# nvdps
    chown system system /sys/devices/platform/host1x/tegradc.0/nvdps
    chown system system /sys/class/graphics/fb0/device/nvdps

# LP5521
    chown system system /sys/bus/i2c/drivers/lp5521/0-0032/select_engine
    chown system system /sys/bus/i2c/drivers/lp5521/0-0032/run_engine

# The loader configuration mediaswcodec actually reads.
#
# It lives inside com.android.media.swcodec and the loader resolves it from
# the executable's own path, so nothing we install elsewhere is consulted --
# bionic/linker/linker.cpp, get_ld_config_file_path(). The copy that
# device.mk puts in /system/etc/swcodec is mounted over it instead, which is
# how three other boards in this tree solve the same problem.
#
# Gated on apexd.status=ready because the mount point does not exist until
# apexd has activated the APEX; run earlier it would silently do nothing.
on property:apexd.status=ready
    mount none /system/etc/swcodec/ld.config.txt /apex/com.android.media.swcodec/etc/ld.config.txt bind

# TLK storage service
import /vendor/etc/init/hw/init.tlk.rc

on property:ro.debuggable=1
    # EMC debug interface
    chmod 666 /sys/kernel/debug/tegra_emc/eack_state

# bugreport is triggered by the VOLUME-DOWN and VOLUME-UP keys
service bugreport /system/bin/dumpstate -d -p -B -o /data/data/com.android.shell/files/bugreports/bugreport
    class main
    disabled
    oneshot
    keycodes 116 115 114

# unified scaling setup
import /vendor/etc/init/hw/init.ussrd.rc

# The kernel arms this watchdog itself: tegra124-tn8.dtsi asks for
# nvidia,enable-on-init with nvidia,heartbeat-init = <120>, and the board
# builds with CONFIG_WATCHDOG_NOWAYOUT, so once it is running nothing can
# stop it again. Something has to feed it or the board resets after two
# minutes, silently -- the driver's interrupt handler prints nothing, so a
# reset leaves no message at all, only a different powerup reason in the
# next boot.
#
# The path below used to be /sbin/watchdogd, which is where the binary sat
# back when the root filesystem came out of a ramdisk. On this release it
# lives in /system/bin, so the service never started, nothing fed the
# watchdog, and every boot carried a hidden deadline of 120 seconds.
#
# The arguments are unchanged and already correct: feed every 10 seconds
# with a 110 second margin, which sets the same 120 the device tree asks
# for.
service watchdogd /system/bin/watchdogd 10 110
    class core
    seclabel u:r:watchdogd:s0
