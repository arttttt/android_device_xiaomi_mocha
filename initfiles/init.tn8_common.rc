on fs
    setprop ro.crypto.tmpfs_options size=128m,mode=0771,uid=1000,gid=1000
    setprop ro.crypto.umount_sd false
    setprop ro.crypto.fuse_sdcard true
    # /vendor/etc, not /, because the ramdisk root is gone by now: first stage
    # init mounts /system and switch_root replaces the root this path used to
    # refer to. The ramdisk copy still exists and is still needed -- it is what
    # first_stage_mount reads before there is a /system -- but it is not
    # reachable from here. mount_all says nothing about an fstab it cannot
    # open: it reads no entries, mounts nothing and returns success.
    mount_all /vendor/etc/fstab.tn8
    # Four compression streams for zram, one per core. Here and not as the
    # fstab's max_comp_streams=: fs_mgr opens the file read-only ("re") and
    # its write is lost without a word. zram takes it before swapon_all sets
    # the disk size.
    write /sys/block/zram0/max_comp_streams 4
    swapon_all /vendor/etc/fstab.tn8

on init
    setprop keyguard.no_require_sim true

service charger /charger
    group graphics input
    seclabel u:r:healthd:s0
    class charger

on charger
    setprop sys.usb.config mtp
    mount ext4 /dev/block/platform/sdhci-tegra.3/by-name/APP /system wait ro
    write /sys/devices/system/cpu/cpuquiet/tegra_cpuquiet/enable 0
    write /sys/devices/system/cpu/cpuquiet/tegra_cpuquiet/no_lp -1
    write /sys/devices/system/cpu/cpu2/online 0
    write /sys/devices/system/cpu/cpu3/online 0
