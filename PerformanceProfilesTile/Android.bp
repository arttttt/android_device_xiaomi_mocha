// Platform-signed for the platform_app domain, which the sepolicy makes a
// client of the mochamanager service, and for ServiceManager, which is
// hidden API. It needs no privileged permission, so it is not a priv-app.
android_app {
    name: "PerformanceTile",
    system_ext_specific: true,
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    platform_apis: true,
    certificate: "platform",
    static_libs: ["MochaManagerClient"],
}
