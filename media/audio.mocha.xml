<audiohal>
	<!-- The card by its ALSA id, not its number: the number depends on
	     which cards registered first (the HDMI card, while it exists, takes
	     0). Streams below inherit this card. -->
	<mixer name="tegrart5671">
		<!--
		  Applied once when the HAL starts: what never changes with the routing.

		  Playback: both outputs take AIF1 through the DAC2 pair (IF1 DAC2 ->
		  DAC L2/R2 Mux -> DAC2 volume). Speaker and headphone then part ways
		  at the mixers their device paths switch. DAC2 stays at 0 dB for both:
		  it is shared, so a per-device value would fight when a ringtone or an
		  alarm plays on speaker and headphones at once. The headphones' -3 dB
		  (stock had DAC2 = 167 for them) is taken on the analogue HP amp
		  instead, which also leaves the digital path to them untouched.

		  The codec DSP's downlink branch (RxDP, DSP DL, TxDC DAC) belongs to
		  stock's AUDIO_MODE_IN_COMMUNICATION setup (echo cancelling for
		  calls); normal playback does not go through it and leaves it alone.
		-->
		<init>
            <ctl name="Left Spk Safeguard Threshold" val="3.53V"/>
            <ctl name="Right Spk Safeguard Threshold" val="3.53V"/>
            <ctl name="Left Spk Safeguard Bypass" val="0"/>
            <ctl name="Right Spk Safeguard Bypass" val="0"/>

            <ctl name="Left Spk Coil Value" val="1uH"/>
            <ctl name="Right Spk Coil Value" val="1uH"/>
            <ctl name="Left Spk Inductance" val="39uH"/>
            <ctl name="Right Spk Inductance" val="39uH"/>

            <ctl name="DAC L2 Mux" val="IF1 DAC"/>
            <ctl name="DAC R2 Mux" val="IF1 DAC"/>
            <ctl name="DAC2 Playback Volume" val="175"/>

            <ctl name="Headphone Jack Switch" val="0"/>
            <ctl name="Mic Jack Switch" val="0"/>
            <ctl name="Int Mic Switch" val="0"/>
            <ctl name="BT Headphone Switch" val="0"/>
            <ctl name="BT Mic Switch" val="0"/>
            <ctl name="FM Switch" val="0"/>
		</init>
	</mixer>

	<!--
	  Device paths: "on"/"off" run for the first stream to use a device and
	  after the last one leaves it, whichever streams those are: PCM or the
	  FM radio's. A path a stream names (<enable>/<disable>) runs for the
	  first and last stream naming it on the device: "on_pcm_rec" for
	  capture, "on_fm" for what only the FM radio takes from a device.
	  Every mixer switch an "on" closes, its "off" opens again, so a device
	  that leaves does not keep a DAPM branch connected.
	-->

	<!--
	  Speakers: the DAC2 pair goes into the mono DAC mixers, loops back
	  through the mono ADC, and leaves on AIF2 for the two TFA9890s.
	  The mono filters' ASRC clocks are left to the kernel, which moves
	  them onto the I2S trackers when AIF1 runs above 48 kHz.
	-->
	<device name="speaker">
        <path name="on">
          <ctl name="Mono DAC MIXL DAC L2 Switch" val="1"/>
          <ctl name="Mono DAC MIXR DAC L2 Switch" val="0"/>
          <ctl name="Mono DAC MIXR DAC R2 Switch" val="1"/>

          <ctl name="Mono ADC L1 Mux" val="Mono DAC MIXL"/>
          <ctl name="Mono ADC R1 Mux" val="Mono DAC MIXR"/>
          <ctl name="Mono ADC MIXL ADC1 Switch" val="1"/>
          <ctl name="Mono ADC MIXR ADC1 Switch" val="1"/>
          <ctl name="IF2 ADC Mux" val="IF_ADC2"/>

          <ctl name="Left Spk Output Voltage" val="8.5V"/>
          <ctl name="Right Spk Output Voltage" val="8.5V"/>
          <ctl name="Left Spk Max Coil Current" val="1.9A"/>
          <ctl name="Right Spk Max Coil Current" val="1.9A"/>
          <ctl name="Left Spk Resistance" val="Auto"/>
          <ctl name="Right Spk Resistance" val="Auto"/>

          <ctl name="Left Spk Input Interface Mux" val="Input1"/>
          <ctl name="Right Spk Input Interface Mux" val="Input1"/>
          <ctl name="Left Spk Input Channel Mux" val="Left"/>
          <ctl name="Right Spk Input Channel Mux" val="Right"/>
          <ctl name="Left Spk Amplifier Channel Mux" val="DSP"/>
          <ctl name="Right Spk Amplifier Channel Mux" val="DSP"/>
          <ctl name="Left Spk Output Channel Mux" index="0" val="Gain"/>
          <ctl name="Left Spk Output Channel Mux" index="1" val="AEC"/>
          <ctl name="Right Spk Output Channel Mux" index="0" val="Current"/>
          <ctl name="Right Spk Output Channel Mux" index="1" val="Gain"/>
          <ctl name="Left Spk Output Interface Mux" val="DSP"/>
          <ctl name="Right Spk Output Interface Mux" val="DSP"/>
          <ctl name="Left Spk Gain Channel Mux" val="Right"/>
          <ctl name="Right Spk Gain Channel Mux" val="Left"/>

          <ctl name="Int Left Spk Switch" val="1"/>
          <ctl name="Int Right Spk Switch" val="1"/>
		</path>
        <path name="off">
          <ctl name="Int Left Spk Switch" val="0"/>
          <ctl name="Int Right Spk Switch" val="0"/>

          <ctl name="Mono DAC MIXL DAC L2 Switch" val="0"/>
          <ctl name="Mono DAC MIXR DAC R2 Switch" val="0"/>
          <ctl name="Mono ADC MIXL ADC1 Switch" val="0"/>
          <ctl name="Mono ADC MIXR ADC1 Switch" val="0"/>
        </path>

        <!-- FM, from DAC1 (see the fm device), into the same mono mixers -->
        <path name="on_fm">
            <ctl name="Mono DAC MIXL DAC L1 Switch" val="1"/>
            <ctl name="Mono DAC MIXR DAC R1 Switch" val="1"/>
		</path>
        <path name="off_fm">
            <ctl name="Mono DAC MIXL DAC L1 Switch" val="0"/>
            <ctl name="Mono DAC MIXR DAC R1 Switch" val="0"/>
		</path>
	</device>

	<!--
	  Headphones, and a headset's earpieces: the DAC2 pair goes into the
	  stereo DAC mixer, DAC1 and the HP amp, through the amp's volume
	  (HPOVOL), which FM's volume sets; HPO MIX's other input, DAC1 straight
	  to the amp, would pass it by. A headset is the same output; its
	  microphone is the input device headset_in.
	-->
	<device name="headphone">
        <path name="on">
            <ctl name="Stereo DAC MIXL DAC L2 Switch" val="1"/>
            <ctl name="Stereo DAC MIXR DAC R2 Switch" val="1"/>
            <ctl name="HPOVOL MIXL DAC1 Switch" val="1"/>
            <ctl name="HPOVOL MIXR DAC1 Switch" val="1"/>
            <ctl name="HPO MIX HPVOL Switch" val="1"/>
            <ctl name="Headphone Jack Switch" val="1"/>
		</path>
        <path name="off">
            <ctl name="Headphone Jack Switch" val="0"/>
            <ctl name="Stereo DAC MIXL DAC L2 Switch" val="0"/>
            <ctl name="Stereo DAC MIXR DAC R2 Switch" val="0"/>
            <ctl name="HPO MIX HPVOL Switch" val="0"/>
            <ctl name="HPOVOL MIXL DAC1 Switch" val="0"/>
            <ctl name="HPOVOL MIXR DAC1 Switch" val="0"/>
        </path>

        <!-- FM, from DAC1 (see the fm device), into the stereo mixers -->
        <path name="on_fm">
            <ctl name="Stereo DAC MIXL DAC L1 Switch" val="1"/>
            <ctl name="Stereo DAC MIXR DAC R1 Switch" val="1"/>
        </path>
        <path name="off_fm">
            <ctl name="Stereo DAC MIXL DAC L1 Switch" val="0"/>
            <ctl name="Stereo DAC MIXR DAC R1 Switch" val="0"/>
        </path>
	</device>

	<device name="headset">
        <path name="on">
            <ctl name="Stereo DAC MIXL DAC L2 Switch" val="1"/>
            <ctl name="Stereo DAC MIXR DAC R2 Switch" val="1"/>
            <ctl name="HPOVOL MIXL DAC1 Switch" val="1"/>
            <ctl name="HPOVOL MIXR DAC1 Switch" val="1"/>
            <ctl name="HPO MIX HPVOL Switch" val="1"/>
            <ctl name="Headphone Jack Switch" val="1"/>
		</path>
        <path name="off">
            <ctl name="Headphone Jack Switch" val="0"/>
            <ctl name="Stereo DAC MIXL DAC L2 Switch" val="0"/>
            <ctl name="Stereo DAC MIXR DAC R2 Switch" val="0"/>
            <ctl name="HPO MIX HPVOL Switch" val="0"/>
            <ctl name="HPOVOL MIXL DAC1 Switch" val="0"/>
            <ctl name="HPOVOL MIXR DAC1 Switch" val="0"/>
        </path>

        <!-- FM, from DAC1 (see the fm device), into the stereo mixers -->
        <path name="on_fm">
            <ctl name="Stereo DAC MIXL DAC L1 Switch" val="1"/>
            <ctl name="Stereo DAC MIXR DAC R1 Switch" val="1"/>
        </path>
        <path name="off_fm">
            <ctl name="Stereo DAC MIXL DAC L1 Switch" val="0"/>
            <ctl name="Stereo DAC MIXR DAC R1 Switch" val="0"/>
        </path>
	</device>

	<!--
	  Microphones. The built-in mics record through the codec's voice
	  DSP, in its 48 kHz stereo mode with noise suppression and far-field
	  pickup (the kernel's table): MAIN (IN2) left, AUX (IN4) right, the
	  two mics it works with. Voice recognition and unprocessed capture
	  want it raw: their streams take the raw paths, the DSP bypassed and
	  MAIN on both channels, at the same gains (speech in the hand about
	  -33 dBFS, peaking at -17). The headset mic records raw, the DSP
	  bypassed, until it is measured. DRC/AGC is off on both.

	  Each input sets its whole chain to AIF1: the muxes are shared with
	  the FM capture's tap (the "fm capture" stream), which points them
	  elsewhere.

	  Chain: mic -> BST -> RECMIX -> ADC -> Stereo1 ADC -> TDM slot 0-1 ->
	  DSP UL (DSP, or bypass) -> TxDP -> IF1 ADC1 -> AIF1 TX.

	  The built-in mics' gain is BST, before the ADC, at +40 dB, and TxDP,
	  after the DSP, at 0 dB. With the DSP's ~10 dB on top, speech from a
	  tablet held in the hand reads about -20 dBFS and peaks at -6, a
	  room's air conditioning about -58 dBFS in the pauses. Raising BST
	  instead lowered the DSP's noise suppression; a louder recording is
	  TxDP's to give, past the DSP. The headset mic keeps stock's gain
	  until measured.
	-->
    <device name="mic">
		<path name="on">
          <ctl name="IF1 ADC Mux" val="IF1_ADC1"/>
          <ctl name="IF1 ADC1 IN2 Mux" val="IF1_ADC4"/>
          <ctl name="TDM Data Mux" val="Slot 0-1"/>
          <ctl name="TxDP Capture Volume" val="47"/>
          <ctl name="TxDP SRC Switch" val="Normal"/>
          <ctl name="DRC Switch" val="Disable"/>
          <ctl name="AD STO1 ASRC Switch" val="clk_sysy_div_out"/>
          <ctl name="Stereo1 ADC1 Mux" val="ADC"/>
          <ctl name="Stereo1 ADC Mux" val="ADC1L ADC2R"/>
          <ctl name="ADC 1_2" val="ADC"/>
          <ctl name="IN2 Boost" val="5"/>
          <ctl name="IN4 Boost" val="5"/>
          <ctl name="RECMIXL BST2 Switch" val="1"/>
          <ctl name="RECMIXL BST4 Switch" val="0"/>
          <ctl name="Sto1 ADC MIXL ADC1 Switch" val="1"/>
          <ctl name="Sto1 ADC MIXR ADC1 Switch" val="1"/>
          <ctl name="Int Mic Switch" val="1"/>
		</path>
        <path name="off">
          <ctl name="Int Mic Switch" val="0"/>
          <ctl name="RECMIXL BST2 Switch" val="0"/>
          <ctl name="Sto1 ADC MIXL ADC1 Switch" val="0"/>
          <ctl name="Sto1 ADC MIXR ADC1 Switch" val="0"/>
        </path>

        <!-- A recording: through the DSP, MAIN left and AUX right -->
        <path name="on_pcm_rec">
          <ctl name="RECMIXR BST2 Switch" val="0"/>
          <ctl name="RECMIXR BST4 Switch" val="1"/>
          <ctl name="DSP Function Switch" val="BuiltinMic 48K-stereo+FFP+NS"/>
          <ctl name="DSP UL Mux" val="DSP"/>
		</path>
        <path name="off_pcm_rec">
          <ctl name="DSP UL Mux" val="Bypass"/>
          <ctl name="DSP Function Switch" val="Disable"/>
          <ctl name="RECMIXR BST4 Switch" val="0"/>
		</path>

        <!-- A raw one (voice recognition, unprocessed): MAIN on both
             channels, from the stereo1 ADC straight to IF1 (IF_ADC1), past
             the DSP and past TxDP too. TxDP passes 16 bits even with the
             DSP bypassed; the ADC gives 24. -->
        <path name="on_pcm_rec_raw">
          <ctl name="RECMIXR BST4 Switch" val="0"/>
          <ctl name="RECMIXR BST2 Switch" val="1"/>
          <ctl name="DSP Function Switch" val="Disable"/>
          <ctl name="DSP UL Mux" val="Bypass"/>
          <ctl name="IF1 ADC1 IN1 Mux" val="IF_ADC1"/>
          <ctl name="IF1 ADC1 IN2 Mux" val="IF1_ADC1_IN1"/>
		</path>
        <path name="off_pcm_rec_raw">
          <ctl name="IF1 ADC1 IN2 Mux" val="IF1_ADC4"/>
          <ctl name="RECMIXR BST2 Switch" val="0"/>
		</path>

        <!-- A VoIP capture (voice communication): through the DSP's 2-mic
             echo cancelling, which runs at 16 kHz behind the RxDP and TxDP
             rate converters. Its reference is the playback mix, taken at
             RxDP; the playback itself stays on DAC2 straight from AIF1, at
             its full bandwidth; through the DSP's downlink it was no
             better cancelled, later and band-limited.
             BST 10 dB lower than the other recordings', at +30 dB: at +40
             the speaker's echo clips AUX's ADC, and the cancelling comes
             and goes. TxDP gives 8 dB of it back, past the DSP; +10 took
             speech in the hand to 0 dBFS. Measured on a test signal
             through the speaker, the echo goes 9-10 dB lower than through
             the noise suppression alone. Speech over loud playback still
             comes out distorted; no table tried did better. -->
        <path name="on_pcm_rec_aec">
          <ctl name="RECMIXR BST2 Switch" val="0"/>
          <ctl name="RECMIXR BST4 Switch" val="1"/>
          <ctl name="DSP ASRC Switch" val="clk_i2s1_track"/>
          <ctl name="RxDP Mux" val="IF1 DAC"/>
          <ctl name="RxDP SRC Switch" val="Divided by 3"/>
          <ctl name="TxDP SRC Switch" val="Multiplied by 3"/>
          <ctl name="DSP Function Switch" val="BuiltinMic AEC-2mic"/>
          <ctl name="DSP DL Mux" val="DSP"/>
          <ctl name="DSP UL Mux" val="DSP"/>
          <ctl name="IN2 Boost" val="3"/>
          <ctl name="IN4 Boost" val="3"/>
          <ctl name="TxDP Capture Volume" val="68"/>
          <!-- The speakers' voice preset and equalizer, for the call -->
          <ctl name="Left Spk Profile" val="Voice"/>
          <ctl name="Right Spk Profile" val="Voice"/>
		</path>
        <path name="off_pcm_rec_aec">
          <ctl name="Left Spk Profile" val="Music"/>
          <ctl name="Right Spk Profile" val="Music"/>
          <ctl name="TxDP Capture Volume" val="47"/>
          <ctl name="IN2 Boost" val="5"/>
          <ctl name="IN4 Boost" val="5"/>
          <ctl name="DSP UL Mux" val="Bypass"/>
          <ctl name="DSP DL Mux" val="Bypass"/>
          <ctl name="DSP Function Switch" val="Disable"/>
          <ctl name="TxDP SRC Switch" val="Normal"/>
          <ctl name="RxDP SRC Switch" val="Normal"/>
          <ctl name="DSP ASRC Switch" val="clk_sysy_div_out"/>
          <ctl name="RECMIXR BST4 Switch" val="0"/>
		</path>
    </device>

    <device name="headset_in">
		<path name="on">
          <ctl name="IF1 ADC Mux" val="IF1_ADC1"/>
          <ctl name="IF1 ADC1 IN2 Mux" val="IF1_ADC4"/>
          <ctl name="TDM Data Mux" val="Slot 0-1"/>
          <ctl name="DSP UL Mux" val="Bypass"/>
          <ctl name="DSP Function Switch" val="Disable"/>
          <ctl name="TxDP Capture Volume" val="108"/>
          <ctl name="TxDP SRC Switch" val="Normal"/>
          <ctl name="DRC Switch" val="Disable"/>
          <ctl name="AD STO1 ASRC Switch" val="clk_sysy_div_out"/>
          <ctl name="Stereo1 ADC1 Mux" val="ADC"/>
          <ctl name="Stereo1 ADC Mux" val="ADC1L ADC2R"/>
          <ctl name="ADC 1_2" val="ADC"/>
          <ctl name="RECMIXL BST1 Switch" val="1"/>
          <ctl name="RECMIXR BST1 Switch" val="1"/>
          <ctl name="Sto1 ADC MIXL ADC1 Switch" val="1"/>
          <ctl name="Sto1 ADC MIXR ADC1 Switch" val="1"/>
          <ctl name="Mic Jack Switch" val="1"/>
		</path>
        <path name="off">
          <ctl name="Mic Jack Switch" val="0"/>
          <ctl name="RECMIXL BST1 Switch" val="0"/>
          <ctl name="RECMIXR BST1 Switch" val="0"/>
          <ctl name="Sto1 ADC MIXL ADC1 Switch" val="0"/>
          <ctl name="Sto1 ADC MIXR ADC1 Switch" val="0"/>
        </path>
    </device>

    <!--
      Bluetooth voice (SCO). BCM4354's Bluetooth audio port is wired to the
      codec's AIF3 and sends the call as linear PCM, 8 kHz (CVSD) or 16 kHz
      (mSBC), the kernel's Bluetooth driver setting the chip up for each
      link. The chip is the port's clock master (the kernel's link has the
      codec as slave), and the filters on AIF3's side of each path run on
      I2S3's tracking ASRC, so the codec follows whatever rate the chip
      sends.
      The BT Headphone and BT Mic pins complete the link for DAPM, which
      then powers it.

      sco, the app to the headset: AIF1 -> DAC2 -> DAC MIX (DAC2 alone,
      not the stereo DAC mixers, which carry sco_in) -> the stereo2 ADC ->
      IF_ADC3 -> IF3 -> the chip. Not the mono ADC: it feeds AIF2 and the
      speakers, which stay routed for the outputs SCO does not take (music
      on the deep buffer output) and would play the call too.

      sco_in, the headset to the app: the chip -> IF3 (its one slot, left,
      copied to both channels) -> DAC1 -> the stereo DAC mixers -> ADC 1_2
      -> the stereo1 ADC -> IF1 ADC1 -> AIF1. DAC1 is FM's otherwise; FM
      gives up the audio focus to a call, and its chain with it.
    -->
    <device name="sco">
        <path name="on">
          <ctl name="DAC MIXL DAC L2 Switch" val="1"/>
          <ctl name="DAC MIXR DAC R2 Switch" val="1"/>
          <ctl name="Stereo2 ADC1 Mux" val="DAC MIX"/>
          <ctl name="Stereo2 ADC LR Mux" val="L"/>
          <ctl name="Sto2 ADC MIXL ADC1 Switch" val="1"/>
          <ctl name="Sto2 ADC MIXR ADC1 Switch" val="1"/>
          <ctl name="AD STO2 ASRC Switch" val="clk_i2s3_track"/>
          <ctl name="IF3 ADC Mux" val="IF_ADC3"/>
          <ctl name="BT Headphone Switch" val="1"/>
        </path>
        <path name="off">
          <ctl name="BT Headphone Switch" val="0"/>
          <ctl name="AD STO2 ASRC Switch" val="clk_sysy_div_out"/>
          <ctl name="Sto2 ADC MIXL ADC1 Switch" val="0"/>
          <ctl name="Sto2 ADC MIXR ADC1 Switch" val="0"/>
          <ctl name="DAC MIXL DAC L2 Switch" val="0"/>
          <ctl name="DAC MIXR DAC R2 Switch" val="0"/>
        </path>
    </device>

    <device name="sco_in">
        <path name="on">
          <ctl name="DAC IF3 Data Switch" val="left copy to right"/>
          <ctl name="DAC1 L Mux" val="IF3 DAC"/>
          <ctl name="DAC1 R Mux" val="IF3 DAC"/>
          <ctl name="DAC1 MIXL DAC1 Switch" val="1"/>
          <ctl name="DAC1 MIXR DAC1 Switch" val="1"/>
          <ctl name="DA STO ASRC Switch" val="clk_i2s3_track"/>
          <ctl name="Stereo DAC MIXL DAC L1 Switch" val="1"/>
          <ctl name="Stereo DAC MIXR DAC R1 Switch" val="1"/>
          <ctl name="ADC 1_2" val="Stereo DAC"/>
          <ctl name="Stereo1 ADC Mux" val="ADC1L ADC2R"/>
          <ctl name="Stereo1 ADC1 Mux" val="ADC"/>
          <ctl name="AD STO1 ASRC Switch" val="clk_sysy_div_out"/>
          <ctl name="DRC Switch" val="Disable"/>
          <ctl name="Sto1 ADC MIXL ADC1 Switch" val="1"/>
          <ctl name="Sto1 ADC MIXR ADC1 Switch" val="1"/>
          <ctl name="IF1 ADC1 IN1 Mux" val="IF_ADC1"/>
          <ctl name="IF1 ADC1 IN2 Mux" val="IF1_ADC1_IN1"/>
          <ctl name="IF1 ADC Mux" val="IF1_ADC1"/>
          <ctl name="BT Mic Switch" val="1"/>
        </path>
        <path name="off">
          <ctl name="BT Mic Switch" val="0"/>
          <ctl name="Sto1 ADC MIXL ADC1 Switch" val="0"/>
          <ctl name="Sto1 ADC MIXR ADC1 Switch" val="0"/>
          <ctl name="Stereo DAC MIXL DAC L1 Switch" val="0"/>
          <ctl name="Stereo DAC MIXR DAC R1 Switch" val="0"/>
          <ctl name="DAC1 MIXL DAC1 Switch" val="0"/>
          <ctl name="DAC1 MIXR DAC1 Switch" val="0"/>
          <ctl name="DA STO ASRC Switch" val="clk_sysy_div_out"/>
          <ctl name="DAC1 L Mux" val="IF1 DAC"/>
          <ctl name="DAC1 R Mux" val="IF1 DAC"/>
          <ctl name="DAC IF3 Data Switch" val="Normal"/>
        </path>
    </device>

    <!--
      The FM radio's own chain, for whichever stream needs it: the patch
      that plays FM on a device, or a capture from the tuner (see the fm
      streams below). Mirrors the stock NV nvaudio_conf.xml fm-tx path:
      BCM4354 FM I2S -> RT5671 AIF4 (IF4) -> DAC1.
      The BCM4354 masters that I2S from its own 37.4 MHz crystal (48 kHz,
      1.536 MHz BCLK; CYW4354 datasheet), unrelated to the codec's clock,
      so the stereo DAC filter tracks I2S4 through the ASRC while FM is on,
      and goes back to the system clock with it: the AIF1 playback it
      serves otherwise is synchronous. DAC1 joins its mixers through the fm
      stream's "mute" use-case, not here.

      The outputs take FM from DAC1 only through their on_fm paths, for
      the patch: the speakers into the mono DAC mixers, the headphones
      into the stereo ones. A capture takes it through the mixers the
      outputs in use do not play (the "fm capture" stream's tap), so FM
      recorded through the render does not reach them a second time, at
      full level, beside the render.
    -->
    <device name="fm">
        <path name="on">
            <ctl name="DAC1 L Mux" val="IF4 DAC"/>
            <ctl name="DAC1 R Mux" val="IF4 DAC"/>
            <ctl name="DA STO ASRC Switch" val="clk_i2s4_track"/>
            <ctl name="FM Switch" val="1"/>
        </path>
        <path name="off">
            <ctl name="FM Playback Volume" val="255"/>
            <ctl name="FM Switch" val="0"/>
            <ctl name="DA STO ASRC Switch" val="clk_sysy_div_out"/>
            <ctl name="DAC1 L Mux" val="IF1 DAC"/>
            <ctl name="DAC1 R Mux" val="IF1 DAC"/>
        </path>
    </device>

	<!-- PCM playback and capture streams.

	     Playback goes through three DAMs in the kernel; device 0 takes
	     capture only.

	     Primary: everything that is not music, on device 6, at 48 kHz.
	     512 x 4 frames, 10.7 ms a period, as stock had it: still short
	     enough for AudioFlinger to run its FastMixer on it, and 43 ms of
	     buffer. With the CPU at its 204 MHz floor a period is now and
	     then late by up to some 20 ms; 256 x 4 held 21 ms, so it ran dry
	     and ALSA stopped and restarted the stream: a crackle in every
	     sound on this output, alarms, ringtones, notifications.

	     Deep buffer: music and video, on device 5, at 48 kHz. 960 x 4
	     frames, 20 ms a period, so the mixer thread and the DMA wake about
	     half as often and a late period costs nothing audible.

	     The two are mixed in one DAM and converted by the next to the back
	     end's rate, which is 48 kHz unless the hifi stream set it.

	     Hifi: the DIRECT output, on device 7, with no rate: it plays at its
	     track's rate and format (44.1 to 96 kHz, 16 or 24 bit, as its PCM
	     reports), and the back end runs at that rate. 1024 x 4 frames, the
	     most the Tegra DMA buffer holds at 24 bits. Its volume is the
	     kernel's HiFi Playback Volume, the gain of the DAM input only this
	     stream goes through, one for both channels: 0.5 dB steps from
	     -63 dB, 0 dB leaving the samples untouched. A DIRECT output's
	     volume on Android 11 is the HAL's alone; it sets it in mB on the
	     control's own dB scale, as it does FM's.

	     What a stream needs of its devices is in their on/off paths,
	     counted per device, so any stream may leave a device while
	     another plays on it. -->
	<stream type="pcm" dir="out" device="6" rate="48000"
	        flags="primary" instances="1"
	        period_size="512" period_count="4">
	</stream>

	<stream type="pcm" dir="out" device="5" rate="48000"
	        flags="deep_buffer" instances="1"
	        period_size="960" period_count="4">
	</stream>

	<stream type="pcm" dir="out" device="7"
	        flags="direct" instances="1"
	        period_size="1024" period_count="4">
		<ctl function="volume" name="HiFi Playback Volume"/>
	</stream>

	<stream type="pcm" dir="in" device="0" rate="48000">
        <enable path="on_pcm_rec"/>
        <disable path="off_pcm_rec"/>
	</stream>

	<!-- The sources that want their capture raw, picked by the HAL by
	     name: the same PCM, through the mics' raw paths. The headset mic
	     has none, and records the same way for every source. -->
	<stream name="voice recognition" type="pcm" dir="in" device="0" rate="48000">
        <enable path="on_pcm_rec_raw"/>
        <disable path="off_pcm_rec_raw"/>
	</stream>

	<stream name="unprocessed" type="pcm" dir="in" device="0" rate="48000">
        <enable path="on_pcm_rec_raw"/>
        <disable path="off_pcm_rec_raw"/>
	</stream>

	<!-- Voice communication, picked by the HAL by name: the built-in
	     mics through the DSP's echo cancelling. The headset mic has no
	     such path, and records as for every source. -->
	<stream name="voice communication" type="pcm" dir="in" device="0" rate="48000">
        <enable path="on_pcm_rec_aec"/>
        <disable path="off_pcm_rec_aec"/>
	</stream>

	<!--
	  The FM radio, played: a "hw" stream with no PCM, which the HAL routes
	  for an audio patch from the tuner to devices: to those devices and
	  to the fm chain. It takes from the speakers only their on_fm path.

	  Its volume is the kernel's FM Playback Volume, set past the point a
	  capture takes FM at, so a recording keeps its full level: on the
	  headphone amplifier and on the TFA9890s at once, DAC1 left at 0 dB
	  but below the amplifier's range. It is the patch's gain in mB, set
	  on the control's own dB scale by set_audio_port_config, and the fm
	  device's "off" puts it back to 0 dB, as the amplifiers carry
	  everything else on their outputs too. DAC1's mixer switches are the "mute"
	  use-case's alone: the HAL closes them ("off") once the fm chain is
	  routed and the gain is on the control's scale, and opens them ("on")
	  for a gain below it and before the chain goes.
	-->
	<stream name="fm" type="hw" dir="out">
		<ctl function="volume" name="FM Playback Volume"/>
		<usecase name="mute">
			<case name="on">
				<ctl name="DAC1 MIXL DAC1 Switch" val="0"/>
				<ctl name="DAC1 MIXR DAC1 Switch" val="0"/>
			</case>
			<case name="off">
				<ctl name="DAC1 MIXL DAC1 Switch" val="1"/>
				<ctl name="DAC1 MIXR DAC1 Switch" val="1"/>
			</case>
		</usecase>
		<enable path="on_fm"/>
		<disable path="off_fm"/>
	</stream>

	<!--
	  The fm chain held for a capture from the tuner: the HAL routes this
	  one to the fm chain alone while an input stream is on the tuner, and
	  turns one of its taps on. The capture comes off AIF1, whose two
	  channels carry IF1 ADC1 or IF1 ADC2, and takes FM from DAC1 through
	  the mixers that no output in use plays, or the outputs would play FM
	  a second time, straight from DAC1 beside the render of the capture:
	  - "mono tap", while the headphones or a headset play: the mono DAC
	    mixers (the speakers'), the mono ADC, IF1 ADC2;
	  - "stereo tap", otherwise: the stereo DAC mixers (the headphones'),
	    ADC 1_2, the stereo1 ADC, IF1 ADC1.
	  Each "on" sets the tap's whole chain, its "off" opens the switches
	  its "on" closed. The HAL turns a tap off before a route changes and
	  the next one on after, so while a tap is on no output in use plays
	  its mixers and its switches are its own; the muxes are left to the
	  next path that sets them, as the microphones do.
	-->
	<stream name="fm capture" type="hw" dir="out">
		<usecase name="mono tap">
			<case name="on">
				<ctl name="Mono ADC L1 Mux" val="Mono DAC MIXL"/>
				<ctl name="Mono ADC R1 Mux" val="Mono DAC MIXR"/>
				<ctl name="IF1 ADC2 IN Mux" val="IF_ADC2"/>
				<ctl name="IF1 ADC2 IN1 Mux" val="IF1_ADC2_IN"/>
				<ctl name="IF1 ADC Mux" val="IF1_ADC2"/>
				<ctl name="Mono ADC MIXL ADC1 Switch" val="1"/>
				<ctl name="Mono ADC MIXR ADC1 Switch" val="1"/>
				<ctl name="Mono DAC MIXL DAC L1 Switch" val="1"/>
				<ctl name="Mono DAC MIXR DAC R1 Switch" val="1"/>
			</case>
			<case name="off">
				<ctl name="Mono DAC MIXL DAC L1 Switch" val="0"/>
				<ctl name="Mono DAC MIXR DAC R1 Switch" val="0"/>
				<ctl name="Mono ADC MIXL ADC1 Switch" val="0"/>
				<ctl name="Mono ADC MIXR ADC1 Switch" val="0"/>
			</case>
		</usecase>
		<usecase name="stereo tap">
			<case name="on">
				<ctl name="ADC 1_2" val="Stereo DAC"/>
				<ctl name="Stereo1 ADC Mux" val="ADC1L ADC2R"/>
				<ctl name="Stereo1 ADC1 Mux" val="ADC"/>
				<ctl name="AD STO1 ASRC Switch" val="clk_sysy_div_out"/>
				<ctl name="DRC Switch" val="Disable"/>
				<ctl name="IF1 ADC1 IN1 Mux" val="IF_ADC1"/>
				<ctl name="IF1 ADC1 IN2 Mux" val="IF1_ADC1_IN1"/>
				<ctl name="IF1 ADC Mux" val="IF1_ADC1"/>
				<ctl name="Sto1 ADC MIXL ADC1 Switch" val="1"/>
				<ctl name="Sto1 ADC MIXR ADC1 Switch" val="1"/>
				<ctl name="Stereo DAC MIXL DAC L1 Switch" val="1"/>
				<ctl name="Stereo DAC MIXR DAC R1 Switch" val="1"/>
			</case>
			<case name="off">
				<ctl name="Stereo DAC MIXL DAC L1 Switch" val="0"/>
				<ctl name="Stereo DAC MIXR DAC R1 Switch" val="0"/>
				<ctl name="Sto1 ADC MIXL ADC1 Switch" val="0"/>
				<ctl name="Sto1 ADC MIXR ADC1 Switch" val="0"/>
			</case>
		</usecase>
	</stream>

</audiohal>

