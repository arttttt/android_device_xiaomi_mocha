<!--
     SetupDesign puts its GLIF screens in a fixed 560x672dp card on anything
     sw600dp or wider. The panel here is 768x1000dp, so the card takes the
     middle of the screen, and the setup wizard's welcome page, a large
     logo and title, does not fit in it: the page scrolls inside the card
     and its buttons are cut off at the card's bottom edge.

     The full-screen templates SetupDesign uses below sw600dp fit the panel
     as they are, so the GLIF templates point back at them.
-->
<resources>
    <item name="sud_glif_template" type="layout">@layout/sud_glif_template_compact</item>
    <item name="sud_glif_list_template" type="layout">@layout/sud_glif_list_template_compact</item>
    <item name="sud_glif_blank_template" type="layout">@layout/sud_glif_blank_template_compact</item>
    <item name="sud_glif_preference_template" type="layout">@layout/sud_glif_blank_template_compact</item>
    <item name="sud_glif_recycler_template" type="layout">@layout/sud_glif_recycler_template_compact</item>
</resources>
