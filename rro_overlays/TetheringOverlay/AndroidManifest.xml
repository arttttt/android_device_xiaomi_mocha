<?xml version="1.0" encoding="utf-8"?>
<!-- Tethering is a mainline module on R, in its own APEX, so its settings are
     resources of com.android.networkstack.tethering, which a static overlay of
     the framework does not reach. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.android.networkstack.tethering.mocha"
    android:versionCode="1"
    android:versionName="1.0">
    <application android:hasCode="false" />
    <overlay
      android:targetPackage="com.android.networkstack.tethering"
      android:targetName="TetheringConfig"
      android:isStatic="true"
      android:priority="0"/>
</manifest>
