# S wants every property type owned by one partition, and these are set and
# read only by vendor domains: the codecs, ussrd and ussr_setup, the power
# HAL and the composer. vendor_internal_prop keeps them from the system side
# altogether.
vendor_internal_prop(mediacodec_prop)
vendor_internal_prop(thermal_prop)
vendor_internal_prop(phs_prop)

# for sys.vrr.min-refr-per-ns
vendor_internal_prop(vrr_prop)

# For sys.perf.profile
vendor_internal_prop(perf_profile_prop)

# The user's two switches, the performance profile and whether the battery
# charges. The mochamanager service sets them for the tiles and MochaManager;
# init turns them into sys.perf.profile and the charger's node.
vendor_internal_prop(mocha_perf_profile_prop)
vendor_internal_prop(mocha_charger_prop)

# For vendor.power.low_power: the battery saver as the power HAL hears it,
# so that power.mocha.rc can hold the profile at power save while it lasts.
vendor_internal_prop(power_low_power_prop)

# For persist.vendor.hwc.display_saturation and display_profile: set by
# LiveDisplay, read by the composer.
vendor_internal_prop(hwc_display_prop)

# For vendor.wlan.driver.version: the Wi-Fi HAL publishes the driver and
# firmware versions it reads off the chip (hardware/interfaces/wifi,
# wifi_chip.cpp). Under the vendor default type only init could set it.
vendor_internal_prop(wifi_version_prop)

# For ro.vendor.usb.rndis.host_addr and dev_addr: conn_init derives the USB
# tethering addresses from the serial number, the gadget HAL writes them into
# the RNDIS function.
vendor_internal_prop(usb_rndis_prop)

# For ro.rfkilldisabled.uim, which brcm-uim-sysfs reads to learn whether to
# leave rfkill alone. Nothing sets it; it reads unset, and without a type of
# its own the read fell to default_prop, which brcm_uim may not read.
vendor_internal_prop(rfkill_uim_prop)
