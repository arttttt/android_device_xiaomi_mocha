# S wants every property type owned by one partition, and these are set and
# read only by vendor domains: the codecs, ussrd and ussr_setup, the power
# HAL and the composer. vendor_internal_prop keeps them from the system side
# altogether.
vendor_internal_prop(mediacodec_prop)
vendor_internal_prop(thermal_prop)
vendor_internal_prop(phs_prop)

# for sys.vrr.min-refr-per-ns
vendor_internal_prop(vrr_prop)

# For sys.perf.profile
vendor_internal_prop(perf_profile_prop)

# For persist.vendor.hwc.display_saturation and display_profile: set by
# LiveDisplay, read by the composer.
vendor_internal_prop(hwc_display_prop)
