# The domain, its exec type and hal_server_domain come from system/sepolicy;
# the binary only needs its label, in file_contexts. What follows is what it
# reads, and it only reads.

# The battery line's INA231. It is found by walking /sys/bus/iio/devices, whose
# entries are links into the I2C bus it hangs off, and a bus carries one label
# for everything on it.
allow hal_power_stats_default sysfs:dir r_dir_perms;
allow hal_power_stats_default sysfs:lnk_file read;
allow hal_power_stats_default sysfs_nvi2c:dir r_dir_perms;
allow hal_power_stats_default sysfs_nvi2c:file r_file_perms;

# The fuel gauge, which bridges a suspend the INA cannot sample.
allow hal_power_stats_default sysfs_batteryinfo:dir search;
allow hal_power_stats_default sysfs_batteryinfo:file r_file_perms;

# Where the time goes: the cores' cpuidle states, the GPU's rail, suspends.
allow hal_power_stats_default sysfs_devices_system_cpu:dir r_dir_perms;
allow hal_power_stats_default sysfs_devices_system_cpu:file r_file_perms;
allow hal_power_stats_default sysfs_rail_stats:file r_file_perms;
allow hal_power_stats_default sysfs_suspend_stats:dir search;
allow hal_power_stats_default sysfs_suspend_stats:file r_file_perms;
