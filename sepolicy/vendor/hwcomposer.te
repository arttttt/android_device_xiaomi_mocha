# The hardware composer service loads hwcomposer.tegra.so, which drives the
# display controller directly. Three kinds of access follow from that, and
# the platform policy grants none of them, since it knows nothing about this
# controller.

# Posting frames and owning display windows: /dev/tegra_dc_ctrl for the event
# stream, /dev/tegra_dc_N for the flips themselves. Both carry the same label.
allow hal_graphics_composer_server tegradc_device:chr_file rw_file_perms;

# The panel timing and the backlight are the framebuffer device's business,
# not the controller's, so that node is read and blanked through here as well.
allow hal_graphics_composer_server graphics_device:chr_file rw_file_perms;

# Buffers arrive as dma-buf descriptors from gralloc and are handed straight
# to the flip. The composer never allocates, but the memory it scans out is
# nvmap memory and the descriptors carry that label.
allow hal_graphics_composer_server gpu_device:chr_file rw_file_perms;

# The panel's power state is read back from the backlight device rather than
# from the controller. That device sits on the first I2C bus, which carries
# one label for everything on it, and finding it means listing
# /sys/class/backlight first.
allow hal_graphics_composer_server sysfs:dir r_dir_perms;
allow hal_graphics_composer_server sysfs_nvi2c:dir search;
allow hal_graphics_composer_server sysfs_nvi2c:file r_file_perms;

# The composer links libbinder, and in a vendor process libbinder's default
# node is /dev/vndbinder. The platform gives a composer hwbinder and nothing
# else, because a composer is not expected to want the other one.
vndbinder_use(hal_graphics_composer_server)
