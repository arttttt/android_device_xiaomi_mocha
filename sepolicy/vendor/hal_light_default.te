# The panel's backlight, the backlight under the capacitive keys and the
# notification LED are three separate devices, and the light HAL drives all
# three. As with power, these rules existed here already -- against
# system_server, from before there was a light HAL to hold them.

# The two backlights. The keys' one is a PWM LED rather than an I2C device,
# but it is the same kind of thing and now carries the same label.
allow hal_light_default sysfs_pwm_backlight:file rw_file_perms;

# What is left sits on the first I2C bus, which carries one label for the
# whole bus: the panel's maximum brightness, in the same directory as the
# brightness itself, and the LED controller's engine at 0-0032.
allow hal_light_default sysfs_nvi2c:dir search;
allow hal_light_default sysfs_nvi2c:file rw_file_perms;
