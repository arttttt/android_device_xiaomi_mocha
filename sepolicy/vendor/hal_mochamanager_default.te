type hal_mochamanager_default, domain;
hal_server_domain(hal_mochamanager_default, hal_mochamanager)

type hal_mochamanager_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_mochamanager_default)

# The battery's energy since boot, which the power.stats HAL integrates.
hal_client_domain(hal_mochamanager_default, hal_power_stats)

# The switches, and the profile in force, which only power.mocha.rc writes.
set_prop(hal_mochamanager_default, mocha_perf_profile_prop)
set_prop(hal_mochamanager_default, mocha_charger_prop)
get_prop(hal_mochamanager_default, perf_profile_prop)

# What it reports. Only reads.
#
# The INA231 is found by walking /sys/bus/iio/devices, links into the I2C bus
# it hangs off, which carries one label for everything on it. The GPU, the
# memory clock, the cluster and the Wi-Fi driver's info string are plain
# sysfs.
allow hal_mochamanager_default sysfs:dir r_dir_perms;
allow hal_mochamanager_default sysfs:file r_file_perms;
allow hal_mochamanager_default sysfs:lnk_file read;
allow hal_mochamanager_default sysfs_nvi2c:dir r_dir_perms;
allow hal_mochamanager_default sysfs_nvi2c:file r_file_perms;
allow hal_mochamanager_default sysfs_batteryinfo:dir r_dir_perms;
allow hal_mochamanager_default sysfs_batteryinfo:file r_file_perms;
allow hal_mochamanager_default sysfs_devices_system_cpu:dir r_dir_perms;
allow hal_mochamanager_default sysfs_devices_system_cpu:file r_file_perms;
allow hal_mochamanager_default sysfs_thermal:dir r_dir_perms;
allow hal_mochamanager_default sysfs_thermal:file r_file_perms;
allow hal_mochamanager_default sysfs_thermal:lnk_file read;
allow hal_mochamanager_default sysfs_zram:dir search;
allow hal_mochamanager_default sysfs_zram:file r_file_perms;
allow hal_mochamanager_default proc_meminfo:file r_file_perms;
allow hal_mochamanager_default proc_pressure_mem:file r_file_perms;
