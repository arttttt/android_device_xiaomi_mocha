# wifi mac loading service
type conn_wifi, domain;
allow conn_wifi init:unix_stream_socket connectto;
allow conn_wifi kernel:system module_request;
allow conn_wifi property_socket:sock_file write;
allow conn_wifi sysfs:file { open read write };


# The service is entered by seclabel from init.t124.rc, which still needs the
# binary to be an entrypoint into this domain -- and it was not even labelled,
# so the transition failed at the first step.
type conn_wifi_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(conn_wifi)

# The factory's copy of the addresses, read raw: it is a bare partition
# rather than a filesystem.
allow conn_wifi bkb_block_device:blk_file r_file_perms;

# When the factory wrote nothing there, the address is derived from the
# serial number instead -- and that half cannot be granted. The platform
# keeps the serial readable by a fixed list of domains and nothing else
# (public/domain.te), for privacy rather than for safety, and a device tree
# cannot add itself to that list any more than it can to dac_override.
#
# So it is not read here: init may read the serial and expands properties in
# a service's arguments, and init.t124.rc hands it to conn_init on the
# command line.

# Either way the result is written out: the Wi-Fi half for the Wi-Fi HAL and
# the driver, the Bluetooth half for the Bluetooth HAL and brcm-uim-sysfs,
# which find it through ro.bt.bdaddr_path.
allow conn_wifi vendor_data_file:file { create_file_perms setattr };
allow conn_wifi bluetooth_vendor_data_file:dir rw_dir_perms;
allow conn_wifi bluetooth_vendor_data_file:file { create_file_perms setattr };

# The USB tethering addresses, for the gadget HAL.
set_prop(conn_wifi, usb_rndis_prop)

# Where the firmware and the calibration are loaded from.
allow conn_wifi sysfs_wifi:file rw_file_perms;
