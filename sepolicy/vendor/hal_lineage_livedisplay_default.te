# The display-profile service. LineageOS defines the attribute and a domain
# for its own sysfs implementation, but not a default one -- that belongs to
# whoever writes a service, which here is us.
type hal_lineage_livedisplay_default, domain;
hal_server_domain(hal_lineage_livedisplay_default, hal_lineage_livedisplay)

type hal_lineage_livedisplay_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_lineage_livedisplay_default)

# The whole of what this service does: name a saturation for the composer to
# build a matrix from, and remember which profile that was. Both properties
# carry a type of their own: on S only init may set vendor_default_prop.
set_prop(hal_lineage_livedisplay_default, hwc_display_prop)
