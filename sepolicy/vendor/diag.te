type diag, domain;
type diag_exec, exec_type, file_type;

init_daemon_domain(diag)

userdebug_or_eng(`

permissive diag;

allow diag fuse:dir { write search add_name };
allow diag fuse:file { write read open create };
allow diag system_file:file { execute_no_trans };

# dac_override was the only capability this domain asked for, and P neverallows
# it outside a whitelist that a device tree cannot join. Left here as a comment
# rather than dropped silently, so it is clear the rule was removed on purpose
# and what it used to grant. The domain labels the NVIDIA stress_test.sh and
# diag_perm.sh, neither of which mocha ships.
#
# Note for anyone editing a .te file: keep apostrophes out of comments. The
# policy is run through m4, where a single quote closes a quoted block, so an
# apostrophe inside userdebug_or_eng() ends the block early.
# allow diag self:capability { dac_override };

')
