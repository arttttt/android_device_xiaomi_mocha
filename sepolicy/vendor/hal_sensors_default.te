# The sensors HAL is sensors.tegra, a blob, and what it needs falls into two
# halves that deserve to be read differently.

# The first half is ordinary. The sensors are IIO devices: samples come off
# the character devices, and everything that configures them -- rates, batch
# sizes, which axes are enabled, the names by which they are recognised --
# is on the first I2C bus, under one label for the whole bus.
allow hal_sensors_default iio_device:chr_file rw_file_perms;

allow hal_sensors_default sysfs_nvi2c:dir r_dir_perms;
allow hal_sensors_default sysfs_nvi2c:file rw_file_perms;

# It finds them by listing /sys/bus/iio/devices, and reads the input device's
# name to tell one board from another.
allow hal_sensors_default sysfs:dir r_dir_perms;
allow hal_sensors_default sysfs:file r_file_perms;

# The second half is that the blob carries samples between its own threads
# through named pipes it makes in /data. Opening and reading those is
# granted here; it is wider than a sensor driver should need, because the
# pipes sit in the system data directory rather than in one of their own.
allow hal_sensors_default system_data_file:dir { create open getattr search read write add_name remove_name rmdir };
allow hal_sensors_default system_data_file:fifo_file { create open getattr read write unlink };
allow hal_sensors_default system_data_file:file r_file_perms;

# What is deliberately not granted is how the blob makes and removes them: it
# shells out to rm and mkfifo, and the boot log is full of it being denied a
# shell and toybox.
#
# That is not an oversight. The platform forbids it outright -- no HAL may
# execute a program without changing domain, with exactly two exemptions
# named in hal_neverallows.te, and neither is a sensor driver. Writing the
# rule does not produce a wider policy, it produces a policy that does not
# build.
#
# The legitimate form is a helper domain: a transition on the shell, so that
# whatever the blob runs lands somewhere that may touch the pipes and nothing
# else. That is a domain to design rather than a rule to add, and it is worth
# doing when this blob is replaced or when this board goes enforcing. Until
# then the shell-outs simply fail, which on a permissive device costs
# nothing.
