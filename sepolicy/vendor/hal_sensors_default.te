# The sensors HAL is our own, sensors-subhal.mocha under AOSP's multi-HAL.
#
# The hub's sensors are IIO devices: samples come off
# the character devices, and everything that configures them -- rates, batch
# sizes, which axes are enabled, the names by which they are recognised --
# is on the first I2C bus, under one label for the whole bus.
allow hal_sensors_default iio_device:chr_file rw_file_perms;

allow hal_sensors_default sysfs_nvi2c:dir r_dir_perms;
allow hal_sensors_default sysfs_nvi2c:file rw_file_perms;

# It finds them by listing /sys/bus/iio/devices, and reads the input device's
# name to tell one board from another.
allow hal_sensors_default sysfs:dir r_dir_perms;
allow hal_sensors_default sysfs:file r_file_perms;

# It keeps the hub's calibration in /data/vendor/sensors, and watches the
# directory for the accelerometer's calibration the settings write there, to
# take it as soon as it lands.
allow hal_sensors_default sensors_vendor_data_file:dir { create_dir_perms watch };
allow hal_sensors_default sensors_vendor_data_file:file create_file_perms;

# The ambient light sensor reports through the input layer; the HAL holds its
# event node open and sets the clock its events are stamped with.
allow hal_sensors_default input_device:dir r_dir_perms;
allow hal_sensors_default input_device:chr_file r_file_perms;
