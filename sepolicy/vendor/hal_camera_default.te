# The camera HAL links libbinder, and in a vendor process libbinder's default
# node is /dev/vndbinder. The platform grants a camera HAL hwbinder and
# nothing else, because a camera HAL is not expected to want the other one.
vndbinder_use(hal_camera_default)

# It keeps its ISP's compiled pipelines in /data/vendor/camera, replacing the
# file whole (a temporary file renamed over it) so a reader never sees half.
allow hal_camera_default camera_vendor_data_file:dir rw_dir_perms;
allow hal_camera_default camera_vendor_data_file:file create_file_perms;

# Its hints to the power HAL -- opening, a shot, streaming at a load -- over
# the AIDL IPower, which is registered with servicemanager on /dev/binder.
hal_client_domain(hal_camera_default, hal_power)
binder_use(hal_camera_default)
