# R declares the domain itself in system/sepolicy/vendor, for its own
# usb.gadget@1.1 service: the type, hal_server_domain and init_daemon_domain.
# Declaring them here as well, as Q needed, is a duplicate type that stops
# checkpolicy. Our binary only needs its label, in file_contexts.

# Composing the gadget is writing configfs, and knowing when a function is
# ready is watching the adb directory under functionfs. Both of those come
# with the attribute above, which is the whole reason the platform bothered
# to declare it without an implementation.
#
# What does not come with it is which controller to bind the gadget to. That
# is not ours to know -- the kernel names it and init publishes it.
get_prop(hal_usb_gadget_default, usb_control_prop)

# getUsbSpeed answers from the controller's current_speed, reached through the
# /sys/class/udc link.
allow hal_usb_gadget_default sysfs:dir r_dir_perms;
allow hal_usb_gadget_default sysfs:lnk_file read;
allow hal_usb_gadget_default sysfs_udc:file r_file_perms;

# The addresses conn_init derives for the RNDIS function.
get_prop(hal_usb_gadget_default, usb_rndis_prop)
