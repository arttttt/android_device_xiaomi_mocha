# Graphics memory on this board is nvmap's, and the only account of who holds
# what is a debugfs file per process. A memtrack HAL has no ordinary reason
# to read debugfs, so nothing in the platform grants it.
#
# The file gets a label of its own rather than debugfs being opened at large:
# an accounting HAL that could read every debugfs file would be a far bigger
# grant than the one thing it needs.
allow hal_memtrack_default debugfs_nvmap:dir r_dir_perms;
allow hal_memtrack_default debugfs_nvmap:file r_file_perms;
