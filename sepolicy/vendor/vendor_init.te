# /mnt/tmp, made in "on init" in init.t124.rc to host the Wi-Fi nvram and the
# shared memory the performance daemon uses.
#
# The commands in a board's rc file run as vendor_init, not as init -- which
# is the whole reason that domain exists. A first attempt granted this to
# init and changed nothing, because init was never the one asking.
allow vendor_init tmpfs:dir { create write add_name };
