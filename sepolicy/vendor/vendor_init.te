# /mnt/tmp, made in "on init" in init.t124.rc to host the Wi-Fi nvram and the
# shared memory the performance daemon uses.
#
# The commands in a board's rc file run as vendor_init, not as init -- which
# is the whole reason that domain exists. A first attempt granted this to
# init and changed nothing, because init was never the one asking.
allow vendor_init tmpfs:dir { create write add_name };

# power.mocha.rc and init.tegra.rc carry the user's two switches over to
# what the board acts on: the profile into sys.perf.profile, the charger
# switch into its node. Expanding ${persist.vendor.mocha...} in those actions
# is a read made as vendor_init. The battery saver flag is reset here at boot.
get_prop(vendor_init, mocha_perf_profile_prop)
get_prop(vendor_init, mocha_charger_prop)
# The switch goes to force_bypass, and init.tegra.rc hands disabled_by_user
# over to the health HAL's user at boot.
allow vendor_init sysfs_nvi2c:dir search;
allow vendor_init sysfs_charger_control:file { w_file_perms setattr };
set_prop(vendor_init, power_low_power_prop)
# And the profile in force is theirs to set: power.mocha.rc is its writer.
set_prop(vendor_init, perf_profile_prop)

# The undervolt: power.mocha.rc triggers on sys.perf.undervoltage and writes
# the rails' offsets, vdd_core_offs and vdd_gpu_offs, under debugfs's clock
# directory. debugfs is no file_type, so nothing vendor_init holds reaches it.
get_prop(vendor_init, undervoltage_prop)
allow vendor_init debugfs_clock:dir search;
allow vendor_init debugfs_clock:file w_file_perms;

# init.tn8.rc makes /data/vendor/sensors, where the sensor hub's calibration
# is kept.
allow vendor_init sensors_vendor_data_file:dir { create search getattr setattr };

# init.tn8.rc makes /data/vendor/camera, where the camera HAL keeps what it
# keeps between its runs.
allow vendor_init camera_vendor_data_file:dir { create search getattr setattr };

# init.tn8.rc and init.t124.rc set VM tunables; see genfs_contexts.
allow vendor_init proc_vm_board:file w_file_perms;

# init.tlk.rc makes the trusted OS's /data/tlk and /data/ss, and
# init.ussrd.rc PHS's /data/misc/phs.
allow vendor_init { tee_data_file phsd_data }:dir { create search getattr setattr };

# power.mocha.rc sets the image compositor's load target, which lives in
# debugfs.
allow vendor_init debugfs_vic_scaling:file w_file_perms;
