# /mnt/tmp, made in "on init" in init.t124.rc to host the Wi-Fi nvram and the
# shared memory the performance daemon uses.
#
# The commands in a board's rc file run as vendor_init, not as init -- which
# is the whole reason that domain exists. A first attempt granted this to
# init and changed nothing, because init was never the one asking.
allow vendor_init tmpfs:dir { create write add_name };

# power.mocha.rc and init.tn8.rc carry the tiles' choices over to what the
# board acts on: the profile into sys.perf.profile, the charger switch into
# its node. Expanding ${persist.sys...} in those actions is a read made as
# vendor_init. The battery saver flag is reset here at boot.
get_prop(vendor_init, perf_profile_user_prop)
get_prop(vendor_init, charger_disabled_prop)
set_prop(vendor_init, power_low_power_prop)
# And the profile in force is theirs to set: power.mocha.rc is its writer.
set_prop(vendor_init, perf_profile_prop)

# The undervolt: power.mocha.rc triggers on sys.perf.undervoltage and writes
# the rails' offsets, vdd_core_offs and vdd_gpu_offs, under debugfs's clock
# directory. debugfs is no file_type, so nothing vendor_init holds reaches it.
get_prop(vendor_init, undervoltage_prop)
allow vendor_init debugfs_clock:dir search;
allow vendor_init debugfs_clock:file w_file_perms;

# init.tn8.rc makes the sensors blob's two directories, /data/sensors and
# /data/sns_lsm6db0_pipes, and sets their owner and mode at every boot.
allow vendor_init sensors_data_file:dir { create search getattr setattr };
