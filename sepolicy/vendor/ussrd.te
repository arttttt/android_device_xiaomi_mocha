#
# ussrd - power management service
#
type ussrd, domain, mlstrustedsubject;
type ussrd_exec, exec_type, file_type;
# ussrd_service moved to sepolicy/public/ussrd.te so plat_sepolicy can
# resolve the type for the service_manager:find rules in private/.
typeattribute ussrd ussrd_domain;

init_daemon_domain(ussrd)

# Allow ussrd to be add a new Binder service, be a binder server, and
# allow clients to connect to the ussrd Binder service.
binder_use(ussrd)
binder_service(ussrd)
allow ussrd ussrd_service:service_manager add;

# /dev/socket/phsd
# Without the ioctl: Q forbids socket ioctls that are not whitelisted through
# allowxperm, and rw_stream_socket_perms carries one. Nothing here issues any.
allow ussrd phsd_socket:unix_stream_socket { rw_socket_perms_no_ioctl listen accept };

# R/W sysfs, /dev nodes
allow ussrd sysfs_devices_system_cpu:file rw_file_perms;
allow ussrd pmqos_device:chr_file rw_file_perms;
allow ussrd sysfs:file r_file_perms;
allow ussrd sysfs_thermal:lnk_file r_file_perms;
allow ussrd sysfs_tegra_gpu:file r_file_perms;
allow ussrd sysfs_tegra_emc:file r_file_perms;

# /data/misc/phs
# Rule states that when a process of type ussrd creates a file in the directory
# of type system_data_file, by default it should have the type phsd_data
type_transition ussrd system_data_file:file phsd_data;
allow ussrd phsd_data:dir { setattr rw_dir_perms };
allow ussrd phsd_data:file create_file_perms;

# /mnt/tmp/fc[0-9] files.
allow ussrd tmpfs:file r_file_perms;
allow ussrd surfaceflinger_fc:file r_file_perms;

# thermal
# Read only: sysfs dirs take no new entries, and policy neverallows asking.
allow ussrd sysfs_thermal:dir r_dir_perms;
allow ussrd sysfs_thermal:file rw_file_perms;

# Allow to write to nvfeedback log file
allow ussrd anr_data_file:file write;

# Allow ussrd to write to set the VRR system property
set_prop(ussrd, vrr_prop)
set_prop(ussrd, thermal_prop)
set_prop(ussrd, phs_prop)

# Allow writing to cfboost params
allow ussrd sysfs_cfboost:file rw_file_perms;

#
# AffinityDaemon functionality
#

# read /proc
ifelse(os_type, `android', allow ussrd self:capability sys_ptrace);
r_dir_file(ussrd, domain)

# set affinity and nice permissions
allow ussrd domain:process { getsched setsched };
allow ussrd self:capability sys_nice;

# netlink access
allow ussrd self:capability net_admin;
allow ussrd self:netlink_socket { create_socket_perms_no_ioctl listen accept };
