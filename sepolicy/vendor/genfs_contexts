genfscon proc /sys/net/core/wmem_default	u:object_r:proc_wmem_default_writable:s0
genfscon proc /sys/net/core/wmem_max		u:object_r:proc_wmem_max_writable:s0
genfscon proc /bluetooth/sleep/lpm		u:object_r:proc_bluetooth_writable:s0
genfscon cifs /					u:object_r:fuse:s0

# Who is holding graphics memory, one file per process. Labelled here rather
# than in file_contexts because debugfs is mounted after init has relabelled.
genfscon debugfs /nvmap/handles_by_pid		u:object_r:debugfs_nvmap:s0

# How long each CPU cluster has run, which MiPad Manager shows.
genfscon debugfs /tegra_hotplug			u:object_r:debugfs_tegra_hotplug:s0

# The power.stats HAL's GPU residency. The rest of /sys/power is the
# platform's, and plain sysfs.
genfscon sysfs /power/tegra_rail_stats		u:object_r:sysfs_rail_stats:s0

# The platform labels /proc/cpu/alignment from T on; S leaves it plain proc,
# and its own init.rc writes it.
genfscon proc /cpu/alignment			u:object_r:proc_cpu_alignment:s0

# init.tn8.rc sets how much of the lower zone is kept from the higher one,
# init.t124.rc how swap and the dentry cache are weighed.
genfscon proc /sys/vm/lowmem_reserve_ratio	u:object_r:proc_vm_board:s0
genfscon proc /sys/vm/swappiness		u:object_r:proc_vm_board:s0
genfscon proc /sys/vm/vfs_cache_pressure	u:object_r:proc_vm_board:s0

# fs_mgr looks for the fstab in the device tree, and on a kernel this old the
# tree is under /proc rather than /sys/firmware, where the platform labels the
# same node sysfs_dt_firmware_android. A proc node may only carry a proc type,
# so it gets one of its own.
genfscon proc /device-tree/firmware/android	u:object_r:proc_dt_firmware_android:s0
