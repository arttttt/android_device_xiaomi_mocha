# The chip's calibration is not on the chip. conn_init writes it into
# /data/vendor/wifi as a text file at boot and the HAL reads it back when it
# brings the interface up. The directory is shared with wpa_supplicant and
# carries the generic vendor label for that reason.
allow hal_wifi_default vendor_data_file:file r_file_perms;
