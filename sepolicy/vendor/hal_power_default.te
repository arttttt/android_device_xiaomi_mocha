# Every knob the power HAL turns belongs to this board, so the platform
# policy grants none of them.
#
# None of it is new ground. All three files were already reachable in this
# tree -- from system_server, which is where the code that wrote them lived
# when this vendor policy was written. Treble moved that code out into a
# process of its own and the rules stayed behind with the old domain. What
# follows is that move, finished.

# The interactive governor's knobs: the pulse a hint turns into, and the
# I/O-busy flag that goes with it.
allow hal_power_default sysfs_devices_system_cpu:file rw_file_perms;

# The floor the GPU's frequency is held above while a hint says the next
# frames are worth paying for. It sits beside gpu_available_rates, which this
# tree labels as information; this one is written, so it is labelled as the
# power knob it is.
allow hal_power_default sysfs_gpu_power_knobs:file rw_file_perms;

# The touch controller's wake mode, which follows the display. It hangs off
# an I2C bus, and a bus carries one label for everything on it, so reaching
# the single node means being allowed to look through the bus.
allow hal_power_default sysfs_nvi2c:dir search;
allow hal_power_default sysfs_nvi2c:file rw_file_perms;

# The profile in force, published as a property because power.mocha.rc keeps
# a block of writes per value and init is what runs them. Its own type rather
# than the system's: nothing outside this HAL sets it, and init may set any
# property regardless of label.
set_prop(hal_power_default, perf_profile_prop)
