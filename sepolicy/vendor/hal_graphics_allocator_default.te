# Android 10 stopped letting most processes open /dev/ashmem themselves and
# put a service in front of it that hands out a file descriptor instead.
# libcutils asks that service first and falls back to the device when it
# cannot find it, which is why this shows up as a denial rather than as a
# failure -- the allocator has been taking the fallback all along.
allow hal_graphics_allocator_default ashmem_device_service:service_manager find;
