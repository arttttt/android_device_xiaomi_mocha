# The board's mochamanager service: the tablet's information and its
# switches, for MochaManager and the quick settings tiles. A HAL in shape --
# a vendor server, system clients -- so it is declared as one, the way the
# platform declares its own (hal_power_stats.te).
hal_attribute(mochamanager)

type hal_mochamanager_service, vendor_service, protected_service, service_manager_type;

binder_call(hal_mochamanager_client, hal_mochamanager_server)
binder_call(hal_mochamanager_server, hal_mochamanager_client)
hal_attribute_service(hal_mochamanager, hal_mochamanager_service)
binder_call(hal_mochamanager_server, servicemanager)
binder_call(hal_mochamanager_client, servicemanager)
