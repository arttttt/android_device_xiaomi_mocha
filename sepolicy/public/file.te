# /sys/devices/platform/7000c000.i2c/i2c-0/0-002c
type sysfs_pwm_backlight, fs_type, sysfs_type;

# /sys/kernel/debug/nvmap/handles_by_pid
type debugfs_nvmap, fs_type, debugfs_type, mlstrustedobject;

# /sys/devices/platform/bcm_ldisc/install
type sysfs_bcm_ldisc, fs_type, sysfs_type;
