# sys.perf.undervoltage: whether the core and GPU rails run below their
# nominal voltage. power.mocha.rc acts on it; the system side will set it.
system_restricted_prop(undervoltage_prop)

# The switches NVIDIA's user-space drivers read wherever they are loaded --
# the allocator, the composer, and the mapper in every process that touches
# a buffer, system or vendor: persist.tegra.* (render compression is set off
# in system_prop.mk; the rest are left unset), persist.sys.tegra.*,
# persist.mocha.gralloc.*, the logging switches of libnvrm and the
# multimedia libraries, nvrm.memmgr.vbose and nvlog.*, and the blitter's,
# nvblit.*. Set from the system build.prop, read by both
# sides: public.
system_public_prop(tegra_driver_prop)

# service.sf.present_timestamp, which surfaceflinger sets and libvulkan reads
# in every process that makes a Vulkan device: the composer, the codecs, the
# camera HAL and apps. Backported from AOSP 0e5bbf934feb, which takes it out
# of system_prop and opens it to every domain for reading.
system_restricted_prop(service_sf_present_timestamp_prop)
