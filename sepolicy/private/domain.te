# The chip's identity -- id, revision, CPU, VP8 fuse -- is read from the fuse
# driver's parameters by libnvrm, NVIDIA's resource manager, which every
# process using the GPU, the display or the media engines loads. That is
# who reads them: here the apps and the platform's graphics processes, in
# vendor/domain.te the vendor ones.
r_dir_file({
  appdomain
  -isolated_app
  bootanim
  surfaceflinger
  system_server
}, sysfs_tegra_info)

# Allow domains to search and create core files
#userdebug_or_eng(`
#allow { domain -recovery -untrusted_app -recovery_refresh -recovery_persist -logd } coredump_data_file:dir create_dir_perms;
#allow { domain -recovery -untrusted_app -recovery_refresh -recovery_persist -logd } coredump_data_file:file create_file_perms;
#')
