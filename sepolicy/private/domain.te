# P narrowed the sysfs surface isolated_app is allowed to see down to
# sysfs_devices_system_cpu and sysfs_usb, and enforces it with a neverallow
# (system/sepolicy/private/isolated_app.te). `domain` includes isolated_app,
# so these three blanket grants failed the policy build outright.
#
# The types themselves stay: every other domain still reads the chip id, the
# fuse AID and the USB bus the way NVIDIA's stack expects. Only isolated_app
# is carved out, which is exactly what the neverallow asks for and costs us
# nothing -- an isolated process has no business reading the SoC serial.
r_dir_file({ domain -isolated_app }, sysfs_bus_usb)
r_dir_file({ domain -isolated_app }, sysfs_tegra_info)
r_dir_file({ domain -isolated_app }, sysfs_tegrafuse_aid)

# Allow domains to search for debugfs_clock/debugfs_edp
allow domain debugfs_clock:dir search;
allow domain debugfs_edp:dir search;

# Allow domains to search and create core files
#userdebug_or_eng(`
#allow { domain -recovery -untrusted_app -recovery_refresh -recovery_persist -logd } coredump_data_file:dir create_dir_perms;
#allow { domain -recovery -untrusted_app -recovery_refresh -recovery_persist -logd } coredump_data_file:file create_file_perms;
#')
