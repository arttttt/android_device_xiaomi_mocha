# The chip's identity -- id, revision, CPU, VP8 fuse -- is read from the fuse
# driver's parameters by libnvrm, NVIDIA's resource manager, which every
# process using the GPU, the display or the media engines loads. That is
# who reads them: here the apps and the platform's graphics processes, in
# vendor/domain.te the vendor ones.
r_dir_file({
  appdomain
  -isolated_app
  bootanim
  surfaceflinger
  system_server
}, sysfs_tegra_info)

# The zygote's shim is attached by the linker, which TARGET_LD_SHIM_LIBS tells
# to match on /system/bin/app_process32 (BoardConfig.mk). LineageOS's linker
# resolves every path on that list in every process it starts, and probes it
# with access() first (bionic/linker/linker.cpp, parse_LD_SHIM_LIBS). Only
# the zygote's domains may read app_process32, so everything else is refused
# the probe -- and then uses the path unresolved, which is already the real
# one. Nothing is lost; only the probe is kept out of the log. audit_access
# silences access() alone: an actual open or read is still reported.
#
# While permissive the probe passes, and the linker goes on to realpath(),
# whose lstat() is a getattr on the same file. Nothing reads the file there
# either, so that is kept out of the log too.
dontaudit domain zygote_exec:file { audit_access getattr };

# Allow domains to search and create core files
#userdebug_or_eng(`
#allow { domain -recovery -untrusted_app -recovery_refresh -recovery_persist -logd } coredump_data_file:dir create_dir_perms;
#allow { domain -recovery -untrusted_app -recovery_refresh -recovery_persist -logd } coredump_data_file:file create_file_perms;
#')

# NVIDIA's driver switches, render compression among them; see
# public/property.te. gralloc.nvgpu reads them in every process that maps a
# buffer, and that is any process that draws or composes.
get_prop(domain, tegra_driver_prop)

# libvulkan reads whether surfaceflinger reports present times wherever a
# Vulkan device is made; see public/property.te.
get_prop(domain, service_sf_present_timestamp_prop)
