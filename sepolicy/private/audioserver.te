set_prop(audioserver, audio_prop)

r_dir_file(audioserver, sysfs)

allow audioserver stats_share_file:dir create_dir_perms;
allow audioserver stats_share_file:file create_file_perms;

# audioserver searches through sysfs, so we need to allow it to search all dirs we retag
r_dir_file(audioserver, sysfs_ozmo);

allow audioserver frostaudiortp_domain:unix_stream_socket connectto;
allow audioserver frostaudiortp_domain:unix_dgram_socket { sendto read write setopt };

# access to frost routing property audio.frost_routing.priority
set_prop(audioserver, frost_routing_prop)
