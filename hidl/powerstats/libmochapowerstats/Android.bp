// What the board can tell about its power, without an interface on it: the
// battery's energy from the INA231 and where the time goes, from sysfs. The
// power.stats service links it statically and only translates its IDL into
// these calls, so a new version of the interface is a new wrapper and not a
// new meter.
cc_library_static {
    name: "libmochapowerstats",
    proprietary: true,
    srcs: [
        "BatteryMeter.cpp",
        "Residency.cpp",
    ],
    export_include_dirs: ["include"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    shared_libs: [
        "libbase",
        "liblog",
    ],
}
