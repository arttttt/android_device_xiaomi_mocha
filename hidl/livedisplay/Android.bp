cc_binary {
    name: "vendor.lineage.livedisplay@2.0-service.mocha",
    relative_install_path: "hw",
    init_rc: ["vendor.lineage.livedisplay@2.0-service.mocha.rc"],
    srcs: [
        "DisplayModes.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libhidlbase",
        "libhidltransport",
        "libhwbinder",
        "liblog",
        "libutils",
        "vendor.lineage.livedisplay@2.0",
    ],
    proprietary: true,
}
