// The board's USB gadget without an interface on it. The gadget HAL services
// link it statically and only translate their IDL into its calls, so moving to
// a new version of the interface, or from HIDL to AIDL, is a new wrapper and
// not a new gadget.
cc_library_static {
    name: "libmochausb",
    proprietary: true,
    srcs: [
        "FfsMonitor.cpp",
        "Gadget.cpp",
        "GadgetConfig.cpp",
    ],
    export_include_dirs: ["include"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    shared_libs: [
        "libbase",
        "libcutils",
        "liblog",
    ],
    // FfsMonitor.h holds its descriptors in unique_fd.
    export_shared_lib_headers: ["libbase"],
}
