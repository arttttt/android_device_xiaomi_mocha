cc_binary {
    proprietary: true,
    defaults: ["hidl_defaults"],
    relative_install_path: "hw",
    name: "android.hardware.power@1.3-service.mocha",
    init_rc: ["android.hardware.power@1.3-service.mocha.rc"],
    srcs: [
        "BoostPulse.cpp",
        "GpuFloor.cpp",
        "Power.cpp",
        "Profiles.cpp",
        "service.cpp",
    ],

    cflags: [
        "-Wall",
        "-Werror",
    ],

    shared_libs: [
        "liblog",
        "libdl",
        "libutils",
        "libcutils",
        "libhardware",
        "libhidlbase",
        "android.hardware.power@1.3",
    ],
}
