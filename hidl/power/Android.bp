cc_binary {
    name: "android.hardware.power-service.mocha",
    relative_install_path: "hw",
    init_rc: ["android.hardware.power-service.mocha.rc"],
    srcs: [
        "BoostPulse.cpp",
        "CameraHints.cpp",
        "GpuFloor.cpp",
        "Power.cpp",
        "Profiles.cpp",
        "ProviderWatch.cpp",
        "QosFloor.cpp",
        "service.cpp",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "liblog",
        "android.hardware.power-V2-ndk_platform",
    ],
    proprietary: true,
}
