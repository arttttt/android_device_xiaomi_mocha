cc_binary {
    name: "android.hardware.vibrator@1.1-service.mocha",
    relative_install_path: "hw",
    init_rc: ["android.hardware.vibrator@1.1-service.mocha.rc"],
    srcs: [
        "Actuator.cpp",
        "Effects.cpp",
        "service.cpp",
        "Vibrator.cpp",
    ],
    shared_libs: [
        "libhidlbase",
        "libhidltransport",
        "liblog",
        "libhwbinder",
        "libutils",
        "libhardware",
        // Both, not just the newer one. A minor version's generated library
        // carries only what that version added; the vtable of the interface
        // it extends lives in the older library, and a class deriving from
        // 1.1 needs both to link.
        "android.hardware.vibrator@1.0",
        "android.hardware.vibrator@1.1",
    ],
    proprietary: true,
}
