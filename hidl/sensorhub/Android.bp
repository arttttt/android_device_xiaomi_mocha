// The LSM6DB0 hub's sensors, without an interface on them. Its types are
// libhardware's sensor_t and sensors_event_t, plain C that outlives any
// IDL: the sensors HAL links it and only translates, so a new version of
// the interface is a new wrapper and not a new reader.
cc_library_static {
    name: "libmochasensors",
    proprietary: true,
    srcs: [
        "libmochasensors/IioDevice.cpp",
        "libmochasensors/SensorHub.cpp",
    ],
    export_include_dirs: ["libmochasensors/include"],
    header_libs: ["libhardware_headers"],
    export_header_lib_headers: ["libhardware_headers"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    shared_libs: [
        "libbase",
        "liblog",
    ],
}

// The library run from a shell, with the sensors HAL stopped: what each
// sensor gives, at what rate and how late. Not installed; built by name
// and pushed by hand.
cc_binary {
    name: "sensorhub_test",
    proprietary: true,
    srcs: ["tools/sensorhub_test.cpp"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
    static_libs: ["libmochasensors"],
    shared_libs: [
        "libbase",
        "liblog",
    ],
}
