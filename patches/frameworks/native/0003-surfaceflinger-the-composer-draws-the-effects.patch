From: arttttt <artem-bambalov@yandex.ru>
Subject: [PATCH] surfaceflinger: the composer draws the effects

On this device SurfaceFlinger composed on the GPU for one reason only in
the transition traces: rounded corners. The launcher's spring animation
back to home rounds the closing application's leash, the radius is
inherited by every child, and isClientCompositionForced hands the whole
group to RenderEngine -- 27-35 frames a run, 2.6 ms each on the main
thread, the commonest class of late frame left.

With ro.surface_flinger.hwc_draws_effects set, no effect forces client
composition any more -- rounded corners in OutputLayer; shadows, blur
and stretch in Layer. Only HDR Y410 still goes to the GPU. Every effect
is handed to the composer instead, as generic layer metadata, one key
each under org.lineageos.mocha.: rounded_corners, shadow, blur and
stretch, as floats in display space (stretch in the layer's own space,
as RenderEngine takes it); the layout is spelled out above
writeEffectsMetadata. A key is sent only once the composer declares it,
so nothing reaches the composer that it would refuse, and then every
frame, all zero when the layer has no such effect, since generic
metadata cannot unset a key.

A composer that has not declared a key shows the layer without that
effect.

diff --git a/services/surfaceflinger/CompositionEngine/src/OutputLayer.cpp b/services/surfaceflinger/CompositionEngine/src/OutputLayer.cpp
index 87be750..7d7c937 100644
--- a/services/surfaceflinger/CompositionEngine/src/OutputLayer.cpp
+++ b/services/surfaceflinger/CompositionEngine/src/OutputLayer.cpp
@@ -15,6 +15,7 @@
  */
 
 #include <DisplayHardware/Hal.h>
+#include <android-base/properties.h>
 #include <android-base/stringprintf.h>
 #include <compositionengine/DisplayColorProfile.h>
 #include <compositionengine/LayerFECompositionState.h>
@@ -692,8 +693,13 @@ void OutputLayer::detectDisallowedCompositionTypeChange(hal::Composition from,
 }
 
 bool OutputLayer::isClientCompositionForced(bool isPeekingThrough) const {
+    // With ro.surface_flinger.hwc_draws_effects the composer is told the
+    // corners through generic layer metadata and draws them itself; the
+    // GPU is not asked to compose the frame for them.
+    static const bool hwcDrawsEffects =
+            base::GetBoolProperty("ro.surface_flinger.hwc_draws_effects", false);
     return getState().forceClientComposition ||
-            (!isPeekingThrough && getLayerFE().hasRoundedCorners());
+            (!isPeekingThrough && !hwcDrawsEffects && getLayerFE().hasRoundedCorners());
 }
 
 void OutputLayer::applyDeviceCompositionTypeChange(hal::Composition compositionType) {
diff --git a/services/surfaceflinger/Layer.cpp b/services/surfaceflinger/Layer.cpp
index 45875c1..2d74bb9 100644
--- a/services/surfaceflinger/Layer.cpp
+++ b/services/surfaceflinger/Layer.cpp
@@ -36,6 +36,7 @@
 #include <cutils/compiler.h>
 #include <cutils/native_handle.h>
 #include <cutils/properties.h>
+#include <cstring>
 #include <gui/BufferItem.h>
 #include <gui/LayerDebugInfo.h>
 #include <gui/Surface.h>
@@ -493,13 +494,112 @@ void Layer::preparePerFrameCompositionState() {
     // Force client composition for special cases known only to the front-end.
     // Rounded corners no longer force client composition, since we may use a
     // hole punch so that the layer will appear to have rounded corners.
-    if (isHdrY410() || drawShadows() || drawingState.blurRegions.size() > 0 ||
-        compositionState->stretchEffect.hasEffect()) {
+    //
+    // With ro.surface_flinger.hwc_draws_effects the composer draws the
+    // effects itself, so only HDR Y410 is still left to the GPU.
+    static const bool hwcDrawsEffects =
+            base::GetBoolProperty("ro.surface_flinger.hwc_draws_effects", false);
+    const bool effects = drawShadows() || drawingState.blurRegions.size() > 0 ||
+            compositionState->stretchEffect.hasEffect();
+    if (isHdrY410() || (effects && !hwcDrawsEffects)) {
         compositionState->forceClientComposition = true;
     }
     // If there are no visible region changes, we still need to update blur parameters.
     compositionState->blurRegions = drawingState.blurRegions;
     compositionState->backgroundBlurRadius = drawingState.backgroundBlurRadius;
+
+    if (hwcDrawsEffects) {
+        writeEffectsMetadata(compositionState);
+    }
+}
+
+// The effects as the composer needs them, one generic metadata key each, as
+// little-endian floats in display space. A key the composer did not declare
+// is not sent, so nothing reaches it that it would refuse; a declared key is
+// sent every frame, all zero when the layer has no such effect, because
+// generic metadata has no way to unset a key once set.
+//
+//   rounded_corners  left, top, right, bottom of the rounded crop; radius
+//   shadow           left, top, right, bottom of the caster; length;
+//                    ambient r, g, b, a; spot r, g, b, a; light x, y, z;
+//                    light radius. The colours are the global ones, not yet
+//                    scaled by the caster's alpha, and the light is the
+//                    global one -- SurfaceFlinger centres it on the display
+//                    horizontally, so x is the composer's to place.
+//   blur             background blur radius; region count; then per region
+//                    blur radius, corner radii TL, TR, BL, BR, alpha (layer
+//                    alpha applied), left, top, right, bottom
+//   stretch          width, height, vector x, y, max amount x, y, mapped
+//                    child bounds left, top, right, bottom -- in the
+//                    layer's own space, as RenderEngine takes them
+void Layer::writeEffectsMetadata(compositionengine::LayerFECompositionState* state) {
+    const auto& supported = mFlinger->getHwComposer().getSupportedLayerGenericMetadata();
+    const auto put = [&](const char* key, const std::vector<float>& values) {
+        const auto it = supported.find(key);
+        if (it == supported.end()) {
+            return;
+        }
+        std::vector<uint8_t> blob(values.size() * sizeof(float));
+        memcpy(blob.data(), values.data(), blob.size());
+        state->metadata.insert_or_assign(key,
+                                         compositionengine::GenericLayerMetadataEntry{it->second,
+                                                                                      std::move(
+                                                                                              blob)});
+    };
+
+    const ui::Transform t = getTransform();
+    const float scale = (sqrtf(t[0][0] * t[0][0] + t[0][1] * t[0][1]) +
+                         sqrtf(t[1][0] * t[1][0] + t[1][1] * t[1][1])) /
+            2.0f;
+
+    {
+        std::vector<float> v(5, 0.f);
+        const RoundedCornerState corners = getRoundedCornerState();
+        if (corners.radius > 0.f) {
+            const FloatRect crop = t.transform(corners.cropRect);
+            v = {crop.left, crop.top, crop.right, crop.bottom, corners.radius * scale};
+        }
+        put("org.lineageos.mocha.rounded_corners", v);
+    }
+
+    {
+        std::vector<float> v(17, 0.f);
+        if (drawShadows()) {
+            const renderengine::ShadowSettings& g = mFlinger->mDrawingState.globalShadowSettings;
+            v = {mScreenBounds.left, mScreenBounds.top, mScreenBounds.right,
+                 mScreenBounds.bottom, mEffectiveShadowRadius,
+                 g.ambientColor.r, g.ambientColor.g, g.ambientColor.b, g.ambientColor.a,
+                 g.spotColor.r, g.spotColor.g, g.spotColor.b, g.spotColor.a,
+                 g.lightPos.x, g.lightPos.y, g.lightPos.z, g.lightRadius};
+        }
+        put("org.lineageos.mocha.shadow", v);
+    }
+
+    {
+        const std::vector<BlurRegion> regions = getBlurRegions();
+        std::vector<float> v = {static_cast<float>(getBackgroundBlurRadius()),
+                                static_cast<float>(regions.size())};
+        for (const BlurRegion& r : regions) {
+            const FloatRect rect = t.transform(FloatRect(r.left, r.top, r.right, r.bottom));
+            v.insert(v.end(),
+                     {static_cast<float>(r.blurRadius) * scale, r.cornerRadiusTL * scale,
+                      r.cornerRadiusTR * scale, r.cornerRadiusBL * scale,
+                      r.cornerRadiusBR * scale, r.alpha, rect.left, rect.top, rect.right,
+                      rect.bottom});
+        }
+        put("org.lineageos.mocha.blur", v);
+    }
+
+    {
+        std::vector<float> v(10, 0.f);
+        const StretchEffect s = getStretchEffect();
+        if (s.hasEffect()) {
+            v = {s.width, s.height, s.vectorX, s.vectorY, s.maxAmountX, s.maxAmountY,
+                 s.mappedChildBounds.left, s.mappedChildBounds.top,
+                 s.mappedChildBounds.right, s.mappedChildBounds.bottom};
+        }
+        put("org.lineageos.mocha.stretch", v);
+    }
 }
 
 void Layer::prepareCursorCompositionState() {
diff --git a/services/surfaceflinger/Layer.h b/services/surfaceflinger/Layer.h
index 4085993..b2bd96d 100644
--- a/services/surfaceflinger/Layer.h
