+// A value of one of the effect keys Layer::writeEffectsMetadata fills, its
+// rectangles and lengths taken from the layer stack's space into the
+// display's; the value of any other key, an effect the layer does not have
+// (all zero) or a value of the wrong length, as it came.
+std::vector<uint8_t> effectInDisplaySpace(const std::string& name,
+                                          const std::vector<uint8_t>& value,
+                                          const ui::Transform& displayTransform) {
+    if (value.size() % sizeof(float) != 0) {
+        return value;
+    }
+    std::vector<float> v(value.size() / sizeof(float));
+    memcpy(v.data(), value.data(), value.size());
+    if (std::all_of(v.begin(), v.end(), [](float f) { return f == 0.f; })) {
+        return value;
+    }
+
+    // Where the key keeps them: the index of each rectangle's left, and of
+    // each length.
+    std::vector<size_t> rects;
+    std::vector<size_t> lengths;
+    if (name == "org.lineageos.mocha.rounded_corners" && v.size() == 5) {
+        rects = {0};
+        lengths = {4};
+    } else if (name == "org.lineageos.mocha.shadow" && v.size() == 17) {
+        rects = {0};
+        lengths = {4, 16};
+    } else if (name == "org.lineageos.mocha.blur" && v.size() >= 2 &&
+               v.size() == 2 + 10 * static_cast<size_t>(v[1])) {
+        lengths = {0};
+        for (size_t region = 2; region < v.size(); region += 10) {
+            lengths.insert(lengths.end(), {region, region + 1, region + 2, region + 3, region + 4});
+            rects.push_back(region + 6);
+        }
+    } else {
+        return value;
+    }
+
+    for (const size_t i : rects) {
+        const FloatRect r =
+                displayTransform.transform(FloatRect(v[i], v[i + 1], v[i + 2], v[i + 3]));
+        v[i] = r.left;
+        v[i + 1] = r.top;
+        v[i + 2] = r.right;
+        v[i + 3] = r.bottom;
+    }
+    const float scale = (displayTransform.getScaleX() + displayTransform.getScaleY()) / 2.f;
+    for (const size_t i : lengths) {
+        v[i] *= scale;
+    }
+
+    std::vector<uint8_t> out(value.size());
+    memcpy(out.data(), v.data(), out.size());
+    return out;
+}
+
