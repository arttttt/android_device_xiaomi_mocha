 }
 
+// The effects Layer::writeEffectsMetadata fills come in the layer stack's
+// space and are sent to the composer in the display's.
+struct OutputLayerEffectsMetadataTest : public OutputLayerWriteStateToHWCTest {
+    static constexpr const char* kCornersKey = "org.lineageos.mocha.rounded_corners";
+    static constexpr const char* kShadowKey = "org.lineageos.mocha.shadow";
+    static constexpr const char* kBlurKey = "org.lineageos.mocha.blur";
+
+    static std::vector<uint8_t> blob(const std::vector<float>& v) {
+        std::vector<uint8_t> b(v.size() * sizeof(float));
+        memcpy(b.data(), v.data(), b.size());
+        return b;
+    }
+
+    OutputLayerEffectsMetadataTest() {
+        mLayerFEState.compositionType = Hwc2::IComposerClient::Composition::DEVICE;
+        expectGeometryCommonCalls();
+        expectPerFrameCommonCalls();
+        expectSetHdrMetadataAndBufferCalls();
+        expectSetCompositionTypeCall(Hwc2::IComposerClient::Composition::DEVICE);
+        EXPECT_CALL(*mLayerFE, hasRoundedCorners()).WillRepeatedly(Return(false));
+        // Any other key is not these tests' business.
+        EXPECT_CALL(*mHwcLayer, setLayerGenericMetadata(_, _, _))
+                .Times(testing::AnyNumber())
+                .WillRepeatedly(Return(hal::Error::NONE));
+    }
+
+    void put(const char* key, const std::vector<float>& v) {
+        mLayerFEState.metadata[key] = {false, blob(v)};
+    }
+
+    void expectSent(const char* key, const std::vector<float>& v) {
+        EXPECT_CALL(*mHwcLayer, setLayerGenericMetadata(std::string(key), false, blob(v)))
+                .WillOnce(Return(hal::Error::NONE));
+    }
+
+    void write() {
+        mOutputLayer.writeStateToHWC(/*includeGeometry*/ true, /*skipLayer*/ false, 0,
+                                     /*zIsOverridden*/ false, /*isPeekingThrough*/ false);
+    }
+
+    // A 2048x1536 layer stack on a 1536x2048 panel, turned a quarter: the
+    // device's landscape.
+    static ui::Transform landscape() { return ui::Transform{ui::Transform::ROT_90, 1536, 2048}; }
+};
+
+TEST_F(OutputLayerEffectsMetadataTest, roundedCornersTurnWithTheDisplay) {
+    mOutputState.transform = landscape();
+    // The recents card: its frame on the panel is 320,307-1328,1741.
+    put(kCornersKey, {307, 208, 1741, 1216, 4});
+    expectSent(kCornersKey, {320, 307, 1328, 1741, 4});
+    write();
+}
+
+TEST_F(OutputLayerEffectsMetadataTest, anAbsentEffectAndOtherKeysGoAsTheyCame) {
+    mOutputState.transform = landscape();
+    put(kShadowKey, std::vector<float>(17, 0.f));
+    expectSent(kShadowKey, std::vector<float>(17, 0.f));
+    // A value of the wrong length is not read by the key's layout.
+    put(kCornersKey, {307, 208, 1741, 1216});
+    expectSent(kCornersKey, {307, 208, 1741, 1216});
+    write();
+}
+
+TEST_F(OutputLayerEffectsMetadataTest, blurRegionsTurnWithTheDisplay) {
+    mOutputState.transform = landscape();
+    // Background radius, one region: radius, corners TL TR BL BR, alpha,
+    // left, top, right, bottom.
+    put(kBlurKey, {10, 1, 20, 1, 2, 3, 4, 0.5f, 307, 208, 1741, 1216});
+    expectSent(kBlurKey, {10, 1, 20, 1, 2, 3, 4, 0.5f, 320, 307, 1328, 1741});
+    write();
+}
+
+TEST_F(OutputLayerEffectsMetadataTest, lengthsScaleWithTheDisplay) {
+    ui::Transform twice;
+    twice.set(2.f, 0.f, 0.f, 2.f);
+    mOutputState.transform = twice;
+    put(kCornersKey, {10, 20, 30, 40, 4});
+    expectSent(kCornersKey, {20, 40, 60, 80, 8});
+    put(kBlurKey, {10, 1, 20, 1, 2, 3, 4, 0.5f, 10, 20, 30, 40});
+    expectSent(kBlurKey, {20, 1, 40, 2, 4, 6, 8, 0.5f, 20, 40, 60, 80});
+    write();
+}
+
