         compositionState->forceClientComposition = true;
     }
     // If there are no visible region changes, we still need to update blur parameters.
     compositionState->blurRegions = drawingState.blurRegions;
     compositionState->backgroundBlurRadius = drawingState.backgroundBlurRadius;
+
+    if (hwcDrawsEffects) {
+        writeEffectsMetadata(compositionState);
+    }
+}
+
+// The effects as the composer needs them, one generic metadata key each, as
+// little-endian floats in the layer stack's space; OutputLayer takes their
+// rectangles and lengths into the display's on the way out, since a turned
+// display's axes are not the layer stack's. A key the composer did not
+// declare is not sent, so nothing reaches it that it would refuse; a
+// declared key is sent every frame, all zero when the layer has no such
+// effect, because generic metadata has no way to unset a key once set.
+//
+//   rounded_corners  left, top, right, bottom of the rounded crop; radius
+//   shadow           left, top, right, bottom of the caster; length;
+//                    ambient r, g, b, a; spot r, g, b, a; light x, y, z;
+//                    light radius. The colours are the global ones, not yet
+//                    scaled by the caster's alpha, and the light is the
+//                    global one -- SurfaceFlinger centres it on the display
+//                    horizontally, so x is the composer's to place; it is
+//                    left in the layer stack's space.
+//   blur             background blur radius; region count; then per region
+//                    blur radius, corner radii TL, TR, BL, BR, alpha (layer
+//                    alpha applied), left, top, right, bottom
+//   stretch          width, height, vector x, y, max amount x, y, mapped
+//                    child bounds left, top, right, bottom -- in the
+//                    layer's own space, as RenderEngine takes them
+void Layer::writeEffectsMetadata(compositionengine::LayerFECompositionState* state) {
+    const auto& supported = mFlinger->getHwComposer().getSupportedLayerGenericMetadata();
+    const auto put = [&](const char* key, const std::vector<float>& values) {
+        const auto it = supported.find(key);
+        if (it == supported.end()) {
+            return;
+        }
+        std::vector<uint8_t> blob(values.size() * sizeof(float));
+        memcpy(blob.data(), values.data(), blob.size());
+        state->metadata.insert_or_assign(key,
+                                         compositionengine::GenericLayerMetadataEntry{it->second,
+                                                                                      std::move(
+                                                                                              blob)});
+    };
+
+    const ui::Transform t = getTransform();
+    const float scale = (sqrtf(t[0][0] * t[0][0] + t[0][1] * t[0][1]) +
+                         sqrtf(t[1][0] * t[1][0] + t[1][1] * t[1][1])) /
+            2.0f;
+
+    {
+        std::vector<float> v(5, 0.f);
+        const RoundedCornerState corners = getRoundedCornerState();
+        if (corners.radius > 0.f) {
+            const FloatRect crop = t.transform(corners.cropRect);
+            v = {crop.left, crop.top, crop.right, crop.bottom, corners.radius * scale};
+        }
+        put("org.lineageos.mocha.rounded_corners", v);
+    }
+
+    {
+        std::vector<float> v(17, 0.f);
+        if (drawShadows()) {
+            const renderengine::ShadowSettings& g = mFlinger->mDrawingState.globalShadowSettings;
+            v = {mScreenBounds.left, mScreenBounds.top, mScreenBounds.right,
+                 mScreenBounds.bottom, mEffectiveShadowRadius,
+                 g.ambientColor.r, g.ambientColor.g, g.ambientColor.b, g.ambientColor.a,
+                 g.spotColor.r, g.spotColor.g, g.spotColor.b, g.spotColor.a,
+                 g.lightPos.x, g.lightPos.y, g.lightPos.z, g.lightRadius};
+        }
+        put("org.lineageos.mocha.shadow", v);
+    }
+
+    {
+        const std::vector<BlurRegion> regions = getBlurRegions();
+        std::vector<float> v = {static_cast<float>(getBackgroundBlurRadius()),
+                                static_cast<float>(regions.size())};
+        for (const BlurRegion& r : regions) {
+            const FloatRect rect = t.transform(FloatRect(r.left, r.top, r.right, r.bottom));
+            v.insert(v.end(),
+                     {static_cast<float>(r.blurRadius) * scale, r.cornerRadiusTL * scale,
+                      r.cornerRadiusTR * scale, r.cornerRadiusBL * scale,
+                      r.cornerRadiusBR * scale, r.alpha, rect.left, rect.top, rect.right,
+                      rect.bottom});
+        }
+        put("org.lineageos.mocha.blur", v);
+    }
+
+    {
+        std::vector<float> v(10, 0.f);
+        const StretchEffect s = getStretchEffect();
+        if (s.hasEffect()) {
+            v = {s.width, s.height, s.vectorX, s.vectorY, s.maxAmountX, s.maxAmountY,
+                 s.mappedChildBounds.left, s.mappedChildBounds.top,
+                 s.mappedChildBounds.right, s.mappedChildBounds.bottom};
+        }
+        put("org.lineageos.mocha.stretch", v);
+    }
 }
 
