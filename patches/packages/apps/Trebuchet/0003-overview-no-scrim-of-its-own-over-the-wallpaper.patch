From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: arttttt <artem-bambalov@yandex.ru>
Date: Mon, 12 Oct 2026 02:30:00 +0300
Subject: [PATCH] overview: no scrim of its own over the wallpaper

Without background blur the overview's scrim is an opaque fill across
the launcher's whole window, and two transitions show it for what it
is. Going home from an app, the fill stands behind the shrinking app
and fades out over the wallpaper -- a dark rectangle that blinks.
Leaving overview with the recents button, the launcher stays above the
app for the whole expansion, and the app grows behind the fill, seen
only through the live tile's card-sized hole.

Take the scrim from a colour of its own, transparent here, so overview
lies over the wallpaper as home does. The taskbar keeps its background:
it is taken from taskbar_background, not from this attribute. An
overlay can give the scrim back by this one colour.
---
 res/values/colors.xml | 5 +++++
 res/values/styles.xml | 4 ++--
 2 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/res/values/colors.xml b/res/values/colors.xml
--- a/res/values/colors.xml
+++ b/res/values/colors.xml
@@ -31,6 +31,11 @@
     <color name="spring_loaded_panel_color">#40FFFFFF</color>
     <color name="spring_loaded_highlighted_panel_border_color">#FFF</color>
 
+    <!-- What overview lays over the wallpaper: nothing, so the
+         wallpaper shows as it does at home. Overlay this to bring the
+         scrim back. -->
+    <color name="overview_background">#00000000</color>
+
     <!-- Popup container -->
     <color name="notification_icon_default_color">#757575</color> <!-- Gray 600 -->
 
diff --git a/res/values/styles.xml b/res/values/styles.xml
--- a/res/values/styles.xml
+++ b/res/values/styles.xml
@@ -64,7 +64,7 @@
         <item name="disabledIconAlpha">.54</item>
         <item name="workspaceAccentColor">@color/workspace_accent_color_light</item>
         <item name="dropTargetHoverTextColor">@color/workspace_text_color_dark</item>
-        <item name="overviewScrimColor">@color/overview_scrim</item>
+        <item name="overviewScrimColor">@color/overview_background</item>
 
         <item name="android:windowTranslucentStatus">false</item>
         <item name="android:windowTranslucentNavigation">false</item>
@@ -123,7 +123,7 @@
         <item name="iconOnlyShortcutColor">#B3FFFFFF</item>
         <item name="workProfileOverlayTextColor">@android:color/white</item>
         <item name="eduHalfSheetBGColor">#DD000000</item>
-        <item name="overviewScrimColor">@color/overview_scrim_dark</item>
+        <item name="overviewScrimColor">@color/overview_background</item>
     </style>
 
     <style name="LauncherTheme.Dark.DarkMainColor" parent="@style/LauncherTheme.Dark">
-- 
2.43.0

